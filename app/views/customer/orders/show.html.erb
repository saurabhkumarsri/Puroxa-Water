<% content_for :title, "Order ##{@order.id}" %>

<div class="max-w-3xl mx-auto">
  <!-- Breadcrumb + Title -->
  <div class="flex items-center gap-3 md:gap-4 mb-6">
    <%= link_to customer_orders_path, class: "flex items-center gap-1 text-gray-500 hover:text-[#0d2c63] text-sm font-medium transition" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back
    <% end %>
    <h1 class="text-xl md:text-2xl font-bold text-gray-800">Order #<%= @order.id %></h1>
  </div>

  <!-- Status Cards -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 mb-6">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4">
      <p class="text-xs text-gray-400 font-medium uppercase tracking-wider mb-1">Status</p>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold <%= @order.status_badge_class %>">
        <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
        <%= @order.status.titleize %>
      </span>
    </div>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4">
      <p class="text-xs text-gray-400 font-medium uppercase tracking-wider mb-1">Payment</p>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold <%= @order.payment_badge_class %>">
        <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
        <%= @order.payment_status.titleize %>
      </span>
    </div>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4">
      <p class="text-xs text-gray-400 font-medium uppercase tracking-wider mb-1">Date</p>
      <p class="font-semibold text-sm text-gray-800"><%= @order.created_at.strftime("%d %b %Y") %></p>
    </div>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4">
      <p class="text-xs text-gray-400 font-medium uppercase tracking-wider mb-1">Mode</p>
      <p class="font-semibold text-sm text-gray-800 uppercase"><%= @order.payment_mode %></p>
    </div>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4">
      <p class="text-xs text-gray-400 font-medium uppercase tracking-wider mb-1">Total</p>
      <p class="font-bold text-lg text-[#0d2c63]">₹<%= @order.total_amount %></p>
    </div>
  </div>

  <!-- Invoice CTA -->
  <div class="mb-6">
    <%= link_to customer_invoice_path(@order),
      class: "inline-flex items-center gap-2 text-sm bg-emerald-600 text-white px-5 py-2.5 rounded-xl hover:bg-emerald-700 hover:shadow-lg hover:-translate-y-0.5 transition font-medium" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
      Download Invoice
    <% end %>
  </div>

  <!-- Items Card -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100">
      <h2 class="font-semibold text-gray-800 flex items-center gap-2">
        <span class="text-lg">🧴</span> Items
      </h2>
    </div>

    <!-- Desktop Table -->
    <div class="hidden md:block overflow-x-auto">
      <table class="w-full text-left">
        <thead class="bg-gray-50/60">
          <tr>
            <th class="py-3 px-5 text-xs font-semibold text-gray-400 uppercase tracking-wider">Product</th>
            <th class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Qty</th>
            <th class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Price</th>
            <th class="text-right text-xs font-semibold text-gray-400 uppercase tracking-wider px-5">Total</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @order.order_items.each do |item| %>
            <tr>
              <td class="py-3.5 px-5">
                <p class="font-medium text-sm text-gray-800"><%= item.product.name %></p>
                <p class="text-xs text-gray-400"><%= item.product.pack_display %></p>
              </td>
              <td class="text-sm text-gray-600"><%= item.quantity %> packs</td>
              <td class="text-sm text-gray-600">₹<%= item.unit_price %></td>
              <td class="text-right px-5 text-sm font-semibold text-gray-800">₹<%= item.total_price %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Mobile Cards -->
    <div class="md:hidden space-y-3 p-4">
      <% @order.order_items.each do |item| %>
        <div class="border border-gray-100 rounded-xl p-3 bg-gray-50">
          <p class="font-medium text-sm text-gray-800"><%= item.product.name %></p>
          <p class="text-xs text-gray-400 mb-2"><%= item.product.pack_display %></p>
          <div class="flex justify-between text-sm">
            <span class="text-gray-600"><%= item.quantity %> packs x ₹<%= item.unit_price %></span>
            <span class="font-semibold text-gray-800">₹<%= item.total_price %></span>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Totals -->
    <div class="px-5 py-4 border-t border-gray-100 bg-gray-50/30 space-y-2">
      <% if @order.discount.present? %>
        <div class="flex justify-between text-sm">
          <span class="text-gray-500">Subtotal</span>
          <span class="font-medium text-gray-700">₹<%= @order.order_items.sum(:total_price) %></span>
        </div>
        <div class="flex justify-between text-sm text-emerald-600">
          <span>Discount (<%= @order.discount.code %> — <%= @order.discount.display_value %>)</span>
          <span class="font-medium">-₹<%= @order.discounted_amount %></span>
        </div>
      <% end %>
      <div class="flex justify-between items-center pt-2 border-t border-gray-200">
        <span class="font-semibold text-gray-800">Grand Total</span>
        <span class="text-xl font-bold text-[#0d2c63]">₹<%= @order.total_amount %></span>
      </div>
    </div>
  </div>

  <!-- Delivery Address -->
  <% if @order.delivery_address.present? %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 md:p-6 mb-6">
      <h2 class="font-semibold text-gray-800 mb-3 flex items-center gap-2">
        <span class="text-lg">📍</span> Delivery Address
      </h2>
      <p class="text-gray-600 text-sm leading-relaxed"><%= @order.delivery_address %></p>
    </div>
  <% end %>

  <!-- Notes -->
  <% if @order.notes.present? %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 md:p-6">
      <h2 class="font-semibold text-gray-800 mb-3 flex items-center gap-2">
        <span class="text-lg">📝</span> Notes
      </h2>
      <p class="text-gray-600 text-sm leading-relaxed"><%= @order.notes %></p>
    </div>
  <% end %>
</div>
