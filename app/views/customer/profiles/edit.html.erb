<% content_for :title, "Edit Profile" %>

<div class="max-w-2xl mx-auto px-0 md:px-0">
  <h1 class="text-xl md:text-2xl font-bold text-gray-800 mb-4 md:mb-6">Edit Profile ✏️</h1>

  <%= form_with model: @user, url: customer_profile_path, method: :patch, class: "bg-white rounded-xl shadow p-4 md:p-6 space-y-3 md:space-y-4" do |f| %>
    <div>
      <%= f.label :first_name, class: "block text-xs md:text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :first_name, class: "w-full border rounded-lg px-3 py-2 text-sm md:text-base" %>
    </div>

    <div>
      <%= f.label :email, class: "block text-xs md:text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, class: "w-full border rounded-lg px-3 py-2 text-sm md:text-base" %>
    </div>

    <div>
      <%= f.label :contact, "Phone Number", class: "block text-xs md:text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :contact, class: "w-full border rounded-lg px-3 py-2 text-sm md:text-base" %>
    </div>

    <div class="flex flex-col sm:flex-row gap-2 md:gap-3 pt-2">
      <%= f.submit "Save Changes",
        class: "bg-[#0d2c63] text-white px-4 py-2 rounded hover:scale-105 transition cursor-pointer text-sm md:text-base" %>
      <%= link_to "Cancel", customer_profile_path,
        class: "px-4 py-2 border rounded hover:bg-gray-50 text-center text-sm md:text-base" %>
    </div>
  <% end %>
</div>
