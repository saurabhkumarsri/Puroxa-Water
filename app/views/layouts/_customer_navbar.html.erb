<header class="bg-white/80 backdrop-blur-md shadow-sm px-4 md:px-6 py-3 md:py-4 flex justify-between items-center sticky top-0 z-50 border-b border-gray-100">
  <!-- Logo -->
  <div class="flex items-center gap-2">
    <div class="w-8 h-8 bg-[#0d2c63] rounded-lg flex items-center justify-center text-white font-bold text-sm">P</div>
    <div class="text-xl md:text-2xl font-bold text-[#0d2c63] tracking-tight">
      <%= link_to "Puroxa Water", root_path %>
    </div>
  </div>

  <% if current_user && current_user.customer? %>
    <!-- Desktop: My Account + Logout -->
    <div class="hidden md:flex items-center gap-4">
      <%= link_to customer_dashboard_path,
        class: "flex items-center gap-2 text-[#0d2c63] font-medium hover:text-cyan-600 transition px-3 py-2 rounded-lg hover:bg-blue-50" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        <span>My Account</span>
      <% end %>
      <div class="h-6 w-px bg-gray-200"></div>
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-full bg-[#0d2c63]/10 flex items-center justify-center text-[#0d2c63] font-semibold text-sm">
          <%= current_user.display_name.first.upcase %>
        </div>
        <span class="text-gray-600 text-sm font-medium"><%= current_user.display_name %></span>
      </div>
      <%= button_to destroy_user_session_path, method: :delete,
        class: "flex items-center gap-1.5 text-red-500 font-medium hover:text-red-700 hover:bg-red-50 text-sm px-3 py-2 rounded-lg transition bg-transparent border-0 cursor-pointer" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
        </svg>
        <span>Logout</span>
      <% end %>
    </div>

    <!-- Mobile: Landing page → Home icon, Other pages → Hamburger (sidebar) -->
    <% if controller_name == "landing" && action_name == "index" %>
      <%= link_to customer_dashboard_path, class: "md:hidden text-gray-700 p-2 rounded-lg hover:bg-gray-100 transition" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
      <% end %>
    <% else %>
      <button class="md:hidden text-gray-700 p-2 rounded-lg hover:bg-gray-100 transition"
        onclick="document.getElementById('mobile-sidebar-overlay').classList.remove('hidden');">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    <% end %>

  <% elsif current_user && current_user.vendor? %>
    <div class="flex items-center gap-3 md:gap-4">
      <span class="text-gray-600 hidden sm:block text-sm font-medium">Vendor Portal</span>
      <%= button_to "Logout", vendor_logout_path, method: :delete,
        class: "text-red-500 font-medium hover:text-red-700 text-sm md:text-base bg-transparent border-0 cursor-pointer px-3 py-2 rounded-lg hover:bg-red-50 transition" %>
    </div>

  <% else %>
    <!-- Mobile Hamburger -->
    <button class="md:hidden text-gray-700 p-2 rounded-lg hover:bg-gray-100 transition"
      onclick="document.getElementById('guest-mobile-menu').classList.toggle('hidden')">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-3">
      <%= link_to "Home", root_path, class: "px-3 py-2 rounded-lg hover:bg-gray-100 text-gray-700 transition font-medium" %>
      <%= link_to "Products", customer_products_path, class: "px-3 py-2 rounded-lg hover:bg-gray-100 text-gray-700 transition font-medium" %>
      <%= link_to "Vendor", vendor_login_path, class: "px-3 py-2 rounded-lg hover:bg-gray-100 text-gray-700 transition font-medium" %>
      <%= link_to "Login", new_user_session_path,
        class: "px-4 py-2 border-2 border-[#0d2c63] rounded-lg hover:bg-[#0d2c63] hover:text-white transition font-medium text-[#0d2c63]" %>
      <%= link_to "Sign up", new_user_registration_path,
        class: "px-5 py-2 bg-[#0d2c63] text-white rounded-lg shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition font-medium" %>
    </nav>
  <% end %>
</header>

<!-- Guest Mobile Menu -->
<% unless current_user %>
  <div id="guest-mobile-menu" class="hidden md:hidden bg-white border-b shadow-lg">
    <nav class="flex flex-col p-4 space-y-2">
      <%= link_to "Home", root_path, class: "block py-3 px-4 rounded-lg text-gray-700 hover:bg-gray-50 font-medium transition" %>
      <%= link_to "Products", customer_products_path, class: "block py-3 px-4 rounded-lg text-gray-700 hover:bg-gray-50 font-medium transition" %>
      <%= link_to "Vendor Portal", vendor_login_path, class: "block py-3 px-4 rounded-lg text-gray-700 hover:bg-gray-50 font-medium transition" %>
      <hr class="border-gray-100">
      <%= link_to "Login", new_user_session_path,
        class: "block py-3 text-center border-2 border-[#0d2c63] rounded-lg hover:bg-[#0d2c63] hover:text-white transition font-medium text-[#0d2c63]" %>
      <%= link_to "Sign up", new_user_registration_path,
        class: "block py-3 text-center bg-[#0d2c63] text-white rounded-lg font-medium" %>
    </nav>
  </div>
<% end %>
