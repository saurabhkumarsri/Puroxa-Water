<% content_for :page_title, "Inventory" %>

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-3">
  <h1 class="text-xl md:text-2xl font-bold text-gray-800">Raw Material Inventory 📦</h1>
  <%= link_to "+ Add Material", new_admin_raw_material_path,
    class: "bg-[#0d2c63] text-white px-4 py-2 rounded-lg hover:shadow-lg hover:-translate-y-0.5 transition text-sm font-medium shrink-0" %>
</div>

<% if @low_stock_count > 0 %>
  <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6 flex items-center gap-3">
    <span class="text-2xl">⚠️</span>
    <div>
      <p class="font-semibold text-red-800">Low Stock Alert</p>
      <p class="text-sm text-red-600"><%= @low_stock_count %> item(s) are at or below minimum stock level.</p>
    </div>
  </div>
<% end %>

<% if @raw_materials.any? %>
  <!-- Desktop Table -->
  <div class="hidden md:block bg-white rounded-xl shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead class="bg-gray-50">
          <tr>
            <th class="py-3 px-4">Name</th>
            <th>Category</th>
            <th>Stock</th>
            <th>Min Level</th>
            <th>Cost/Unit</th>
            <th>Supplier</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @raw_materials.each do |material| %>
            <tr class="border-t hover:bg-gray-50">
              <td class="py-3 px-4 font-medium"><%= material.name %></td>
              <td>
                <span class="text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-700 font-medium">
                  <%= material.category %>
                </span>
              </td>
              <td>
                <span class="text-xs px-2 py-1 rounded-full font-medium <%= material.stock_badge_class %>">
                  <%= material.quantity %> <%= material.unit %>
                </span>
              </td>
              <td><%= material.min_stock_level || "—" %></td>
              <td>₹<%= material.cost_per_unit || "—" %></td>
              <td class="text-sm text-gray-500"><%= material.supplier_name.presence || "—" %></td>
              <td class="text-right px-4">
                <div class="flex gap-2 justify-end">
                  <%= link_to "Edit", edit_admin_raw_material_path(material),
                    class: "text-xs bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700" %>
                  <%= button_to "Delete", admin_raw_material_path(material),
                    method: :delete,
                    data: { turbo_confirm: "Are you sure?" },
                    class: "text-xs bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mobile Cards -->
  <div class="md:hidden space-y-3">
    <% @raw_materials.each do |material| %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
        <div class="flex justify-between items-start mb-2">
          <div>
            <p class="font-bold text-gray-800"><%= material.name %></p>
            <p class="text-xs text-gray-500 mt-0.5"><%= material.category %> · ₹<%= material.cost_per_unit || "—" %>/<%= material.unit %></p>
          </div>
          <span class="text-xs px-2 py-1 rounded-full font-medium <%= material.stock_badge_class %>">
            <%= material.quantity %> <%= material.unit %>
          </span>
        </div>
        <div class="grid grid-cols-2 gap-2 text-sm mb-3">
          <div>
            <p class="text-xs text-gray-400">Min Level</p>
            <p class="font-medium"><%= material.min_stock_level || "—" %></p>
          </div>
          <div>
            <p class="text-xs text-gray-400">Supplier</p>
            <p class="font-medium"><%= material.supplier_name.presence || "—" %></p>
          </div>
        </div>
        <div class="flex gap-2 pt-3 border-t border-gray-100">
          <%= link_to "Edit", edit_admin_raw_material_path(material),
            class: "flex-1 text-center text-xs bg-blue-600 text-white px-3 py-2 rounded-lg hover:bg-blue-700" %>
          <%= button_to "Delete", admin_raw_material_path(material),
            method: :delete,
            data: { turbo_confirm: "Are you sure?" },
            class: "flex-1 text-xs bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-700 bg-transparent border-0 cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl shadow p-10 md:p-16 text-center">
    <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl">📦</div>
    <p class="text-gray-500 text-lg mb-4">No raw materials added yet.</p>
    <%= link_to "Add Material", new_admin_raw_material_path,
      class: "bg-[#0d2c63] text-white px-6 py-2 rounded-lg hover:shadow-lg hover:-translate-y-0.5 transition inline-block font-medium" %>
  </div>
<% end %>
