<% content_for(:title) { "Forgot password — Puroxa Water" } %>

<div class="min-h-[calc(100vh-160px)] flex items-center justify-center px-4 py-10 bg-gradient-to-br from-sky-50 via-white to-cyan-50">
  <div class="w-full max-w-md">

    <div class="bg-white/90 backdrop-blur-md rounded-3xl shadow-2xl border border-gray-100 overflow-hidden">
      <div class="h-1.5 bg-gradient-to-r from-[#0d2c63] via-sky-500 to-cyan-400"></div>

      <div class="p-7 md:p-9">
        <div class="text-center mb-7">
          <div class="inline-flex w-14 h-14 rounded-2xl bg-gradient-to-br from-[#0d2c63] to-cyan-500 items-center justify-center shadow-lg shadow-sky-200 mb-4">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
            </svg>
          </div>
          <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight">Forgot your password?</h1>
          <p class="text-sm text-gray-500 mt-1.5">Enter your email and we'll send reset instructions.</p>
        </div>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
          <%= render "shared/auth_field",
                form: f,
                name: :email,
                type: :email,
                label: "Email address",
                placeholder: "you@example.com",
                autocomplete: "email",
                required: true,
                icon: "M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" %>

          <%= f.submit "Send reset link",
                class: "w-full mt-2 py-3 rounded-xl bg-gradient-to-r from-[#0d2c63] to-sky-600 text-white font-semibold shadow-lg shadow-sky-200 hover:shadow-xl hover:from-[#0d2c63] hover:to-sky-500 hover:-translate-y-0.5 transition cursor-pointer" %>
        <% end %>

        <p class="text-center text-sm text-gray-600 mt-6">
          Remembered it?
          <%= link_to "Back to sign in", new_user_session_path,
                class: "text-[#0d2c63] hover:text-sky-600 font-semibold ml-1" %>
        </p>
      </div>
    </div>
  </div>
</div>
