<% content_for :title, "Pay Online — Order ##{@order.id}" %>

<div class="max-w-xl mx-auto px-4 sm:px-6 py-8 md:py-12">
  <!-- Header -->
  <div class="text-center mb-8 md:mb-10">
    <div class="w-16 h-16 bg-[#0d2c63] rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg">
      <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
      </svg>
    </div>
    <h1 class="text-2xl md:text-3xl font-bold text-gray-900">Pay Online</h1>
    <p class="text-gray-500 mt-2 text-sm md:text-base">Complete your payment using any UPI app</p>
  </div>

  <!-- Order Summary Card -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 md:p-6 mb-6 md:mb-8">
    <div class="flex items-center justify-between mb-4 pb-4 border-b border-gray-100">
      <div>
        <p class="text-xs text-gray-400 uppercase tracking-wider font-medium">Order #</p>
        <p class="font-bold text-gray-800"><%= @order.id %></p>
      </div>
      <div class="text-right">
        <p class="text-xs text-gray-400 uppercase tracking-wider font-medium">You Pay</p>
        <p class="text-2xl font-extrabold text-[#0d2c63]">₹<%= @order.total_with_online_discount %></p>
      </div>
    </div>

    <div class="space-y-2">
      <% @order.order_items.each do |item| %>
        <div class="flex justify-between text-sm">
          <span class="text-gray-600"><%= item.product.name %> × <%= item.quantity %></span>
          <span class="font-medium text-gray-800">₹<%= item.total_price %></span>
        </div>
      <% end %>
    </div>

    <div class="mt-4 pt-3 border-t border-gray-100 space-y-2">
      <div class="flex justify-between text-sm">
        <span class="text-gray-500">Order Total</span>
        <span class="font-medium text-gray-700">₹<%= @order.total_amount + @order.online_discount_amount.to_f %></span>
      </div>
      <% if @order.online_discount_percent.to_i > 0 %>
        <div class="flex justify-between text-sm text-emerald-600">
          <span>Online Discount (<%= @order.online_discount_percent %>%)</span>
          <span class="font-medium">-₹<%= @order.online_discount_amount %></span>
        </div>
      <% end %>
      <div class="flex justify-between items-center pt-2 border-t border-gray-100">
        <span class="font-semibold text-gray-800">Final Amount</span>
        <span class="font-bold text-[#0d2c63]">₹<%= @order.total_with_online_discount %></span>
      </div>
    </div>

    <div class="mt-3 pt-3 border-t border-gray-100 flex justify-between items-center">
      <span class="text-sm text-gray-500">Merchant</span>
      <span class="font-semibold text-gray-800 text-sm"><%= MERCHANT_NAME %></span>
    </div>
  </div>

  <!-- UPI App Options -->
  <div class="space-y-3 md:space-y-4">
    <p class="text-center text-sm text-gray-500 font-medium">Choose your UPI app</p>

    <!-- Google Pay -->
    <a href="<%= @upi_links[:gpay] %>"
       class="group flex items-center gap-4 bg-white rounded-xl shadow-sm border border-gray-100 p-4 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200"
       onclick="return confirm('You will be redirected to Google Pay. Amount: ₹<%= @order.total_with_online_discount %>')">
      <div class="w-12 h-12 bg-[#F2F9F5] rounded-xl flex items-center justify-center shrink-0">
        <img src="/images/googlepay.jpeg" alt="Google Pay" class="w-8 h-8 object-contain">
      </div>
      <div class="flex-1">
        <p class="font-bold text-gray-800">Google Pay</p>
        <p class="text-xs text-gray-400">Tap to open Google Pay</p>
      </div>
      <svg class="w-5 h-5 text-gray-300 group-hover:text-[#0d2c63] transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
    </a>

    <!-- PhonePe -->
    <a href="<%= @upi_links[:phonepe] %>"
       class="group flex items-center gap-4 bg-white rounded-xl shadow-sm border border-gray-100 p-4 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200"
       onclick="return confirm('You will be redirected to PhonePe. Amount: ₹<%= @order.total_with_online_discount %>')">
      <div class="w-12 h-12 bg-[#FFF3E0] rounded-xl flex items-center justify-center shrink-0">
        <img src="/images/phonepay.jpg" alt="PhonePe" class="w-8 h-8 object-contain">
      </div>
      <div class="flex-1">
        <p class="font-bold text-gray-800">PhonePe</p>
        <p class="text-xs text-gray-400">Tap to open PhonePe</p>
      </div>
      <svg class="w-5 h-5 text-gray-300 group-hover:text-[#0d2c63] transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
    </a>

    <!-- Paytm -->
    <a href="<%= @upi_links[:paytm] %>"
       class="group flex items-center gap-4 bg-white rounded-xl shadow-sm border border-gray-100 p-4 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200"
       onclick="return confirm('You will be redirected to Paytm. Amount: ₹<%= @order.total_with_online_discount %>')">
      <div class="w-12 h-12 bg-[#E0F7FA] rounded-xl flex items-center justify-center shrink-0">
        <img src="/images/paytm.jpeg" alt="Paytm" class="w-8 h-8 object-contain">
      </div>
      <div class="flex-1">
        <p class="font-bold text-gray-800">Paytm</p>
        <p class="text-xs text-gray-400">Tap to open Paytm</p>
      </div>
      <svg class="w-5 h-5 text-gray-300 group-hover:text-[#0d2c63] transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
  </div>

  <!-- Generic Fallback -->
  <div class="mt-6 text-center">
    <a href="<%= @upi_links[:generic] %>"
       class="text-sm text-[#0d2c63] hover:underline font-medium inline-flex items-center gap-1"
       onclick="return confirm('Open any UPI app with amount ₹<%= @order.total_with_online_discount %>')">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
      </svg>
      Open in any UPI app
    </a>
  </div>

  <!-- Instructions -->
  <div class="mt-8 bg-blue-50 rounded-xl p-4 md:p-5 border border-blue-100">
    <h3 class="font-semibold text-[#0d2c63] text-sm mb-2 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      How it works
    </h3>
    <ol class="text-xs text-blue-700 space-y-1.5 list-decimal list-inside">
      <li>Choose your preferred UPI app above.</li>
      <li>Your app will open automatically with amount ₹<%= @order.total_with_online_discount %> pre-filled.</li>
      <li>Confirm payment — UPI ID is pre-filled in your app.</li>
      <li>Come back here — vendor will mark it as paid after confirmation.</li>
    </ol>
  </div>

  <!-- Back to order -->
  <div class="mt-8 text-center">
    <%= link_to customer_order_path(@order), class: "text-gray-500 hover:text-[#0d2c63] text-sm font-medium inline-flex items-center gap-1 transition" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
      Back to Order
    <% end %>
  </div>
</div>
