<% content_for :page_title, "Orders" %>

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-3">
  <h1 class="text-xl md:text-2xl font-bold text-gray-800">Orders 📦</h1>
</div>

<!-- Desktop Table -->
<div class="hidden md:block bg-white rounded-xl shadow overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead class="bg-gray-50">
        <tr>
          <th class="py-3 px-4">Order #</th>
          <th>Customer</th>
          <th>Vendor</th>
          <th>Amount</th>
          <th>Status</th>
          <th>Payment</th>
          <th>Mode</th>
          <th>Date</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @orders.each do |order| %>
          <tr class="border-t hover:bg-gray-50">
            <td class="py-3 px-4 font-medium">#<%= order.id %></td>
            <td><%= order.customer.display_name %></td>
            <td><%= order.vendor&.display_name || "—" %></td>
            <td>₹<%= order.total_amount %></td>
            <td>
              <span class="px-2 py-1 rounded-full text-xs font-medium <%= order.status_badge_class %>">
                <%= order.status.titleize %>
              </span>
            </td>
            <td>
              <span class="px-2 py-1 rounded-full text-xs font-medium <%= order.payment_badge_class %>">
                <%= order.payment_status.titleize %>
              </span>
            </td>
            <td class="text-xs text-gray-500 uppercase"><%= order.payment_mode %></td>
            <td class="text-sm text-gray-500"><%= order.created_at.strftime("%d %b %Y") %></td>
            <td class="text-right px-4">
              <%= link_to "View", subadmin_order_path(order), class: "text-[#0d2c63] hover:underline text-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<!-- Mobile Cards -->
<div class="md:hidden space-y-3">
  <% @orders.each do |order| %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
      <div class="flex justify-between items-center mb-2">
        <span class="font-medium text-sm">#<%= order.id %></span>
        <span class="px-2 py-1 rounded-full text-xs font-medium <%= order.status_badge_class %>">
          <%= order.status.titleize %>
        </span>
      </div>
      <div class="grid grid-cols-2 gap-2 text-sm mb-3">
        <div>
          <p class="text-xs text-gray-400">Customer</p>
          <p class="font-medium"><%= order.customer.display_name %></p>
        </div>
        <div>
          <p class="text-xs text-gray-400">Vendor</p>
          <p class="font-medium"><%= order.vendor&.display_name || "—" %></p>
        </div>
        <div>
          <p class="text-xs text-gray-400">Amount</p>
          <p class="font-medium">₹<%= order.total_amount %></p>
        </div>
        <div>
          <p class="text-xs text-gray-400">Payment</p>
          <p class="font-medium"><%= order.payment_status.titleize %></p>
        </div>
        <div>
          <p class="text-xs text-gray-400">Mode</p>
          <p class="font-medium text-gray-600 uppercase"><%= order.payment_mode %></p>
        </div>
        <div>
          <p class="text-xs text-gray-400">Date</p>
          <p class="font-medium"><%= order.created_at.strftime("%d %b %Y") %></p>
        </div>
      </div>
      <div class="pt-3 border-t border-gray-100">
        <%= link_to "View Details", subadmin_order_path(order), class: "block text-center text-xs bg-[#0d2c63] text-white px-3 py-2 rounded-lg hover:opacity-90" %>
      </div>
    </div>
  <% end %>
</div>
