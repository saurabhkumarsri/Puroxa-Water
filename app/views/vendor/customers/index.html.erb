<% content_for :title, "Customers" %>

<div class="max-w-6xl mx-auto">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-3">
    <h1 class="text-xl md:text-2xl font-bold text-gray-800">Customers 👥</h1>
  </div>

  <% if @customers.any? %>
    <!-- Desktop Table -->
    <div class="hidden md:block bg-white rounded-xl shadow overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead class="bg-gray-50">
            <tr>
              <th class="py-3 px-4">Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Orders</th>
              <th>Pending Amount</th>
              <th>Joined</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @customers.each do |customer| %>
              <tr class="border-t hover:bg-gray-50">
                <td class="py-3 px-4 font-medium"><%= customer.display_name %></td>
                <td><%= customer.email %></td>
                <td><%= customer.contact.presence || "—" %></td>
                <td><%= customer.orders.count %></td>
                <td>
                  <% pending = customer.pending_amount %>
                  <% if pending > 0 %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700">
                      ₹<%= number_with_precision(pending, precision: 2) %>
                    </span>
                  <% else %>
                    <span class="text-xs text-emerald-600 font-medium">All Paid ✅</span>
                  <% end %>
                </td>
                <td class="text-sm text-gray-500"><%= customer.created_at.strftime("%d %b %Y") %></td>
                <td class="text-right px-4">
                  <%= link_to "View", vendor_customer_path(customer), class: "text-[#0d2c63] hover:underline text-sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Mobile Cards -->
    <div class="md:hidden space-y-3">
      <% @customers.each do |customer| %>
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-full bg-[#0d2c63] text-white flex items-center justify-center font-bold text-sm shrink-0">
              <%= (customer.shop_name || customer.display_name).first.upcase %>
            </div>
            <div class="min-w-0">
              <p class="font-bold text-gray-800 truncate"><%= customer.shop_name.presence || customer.display_name %></p>
              <p class="text-xs text-gray-500 truncate"><%= customer.area.presence || "—" %> · <%= customer.email %></p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2 text-sm mb-3">
            <div>
              <p class="text-xs text-gray-400">Owner</p>
              <p class="font-medium"><%= customer.first_name.presence || "—" %></p>
            </div>
            <div>
              <p class="text-xs text-gray-400">Phone</p>
              <p class="font-medium"><%= customer.contact.presence || "—" %></p>
            </div>
            <div>
              <p class="text-xs text-gray-400">Orders</p>
              <p class="font-medium"><%= customer.orders.count %></p>
            </div>
            <div>
              <p class="text-xs text-gray-400">Pending Amt</p>
              <p class="font-medium">
                <% pending = customer.pending_amount %>
                <% if pending > 0 %>
                  <span class="text-amber-600">₹<%= number_with_precision(pending, precision: 2) %></span>
                <% else %>
                  <span class="text-emerald-600">All Paid ✅</span>
                <% end %>
              </p>
            </div>
          </div>
          <div class="pt-3 border-t border-gray-100">
            <%= link_to "View Details →", vendor_customer_path(customer),
              class: "block text-center text-xs bg-[#0d2c63] text-white px-3 py-2 rounded-lg hover:opacity-90" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl shadow p-10 md:p-16 text-center">
      <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl">👥</div>
      <p class="text-gray-500 text-lg">No customers found.</p>
    </div>
  <% end %>
</div>
