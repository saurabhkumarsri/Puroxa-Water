<% content_for :title, "Add Address" %>

<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">Add New Address 📍</h1>

  <%= form_with model: @address, url: customer_addresses_path, class: "bg-white rounded-xl shadow p-6 space-y-4" do |f| %>
    <div>
      <%= f.label :label, "Label (e.g. Home, Office)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :label, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div>
      <%= f.label :address_line, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :address_line, rows: 2, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :city, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :city, class: "w-full border rounded-lg px-3 py-2" %>
      </div>
      <div>
        <%= f.label :state, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :state, class: "w-full border rounded-lg px-3 py-2" %>
      </div>
    </div>

    <div>
      <%= f.label :pincode, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :pincode, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div class="flex items-center gap-2">
      <%= f.check_box :is_default %>
      <%= f.label :is_default, "Set as default address", class: "text-sm" %>
    </div>

    <div class="flex gap-3 pt-2">
      <%= f.submit "Save Address",
        class: "bg-[#0d2c63] text-white px-4 py-2 rounded hover:scale-105 transition cursor-pointer" %>
      <%= link_to "Cancel", customer_addresses_path,
        class: "px-4 py-2 border rounded hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
