<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Puroxa Water" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <meta property="og:title" content="<%= content_for(:title) || 'Puroxa Water' %>">
    <meta property="og:description" content="Pure water delivery at your doorstep.">
    <meta property="og:image" content="<%= request.base_url %>/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% if current_user && current_user.customer? %>
    <!-- Logged-in Customer: Admin-style layout -->
    <body class="bg-gray-100 md:h-screen md:overflow-hidden">
      <!-- Mobile Header -->
      <div class="md:hidden bg-[#0d2c63] text-white px-4 py-3 flex items-center justify-between sticky top-0 z-50">
        <button onclick="document.getElementById('mobile-sidebar-overlay').classList.remove('hidden')"
          class="text-white p-1">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <span class="font-semibold"><%= content_for(:title) || "Customer Panel" %></span>
        <div class="flex items-center gap-2">
          <%= link_to customer_notifications_path, class: "relative p-2 text-white/80 hover:text-white" do %>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
            </svg>
            <% unread_mobile = current_user&.notifications&.unread&.count || 0 %>
            <% if unread_mobile > 0 %>
              <span class="absolute -top-0.5 -right-0.5 w-4 h-4 bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center">
                <%= unread_mobile > 9 ? "9+" : unread_mobile %>
              </span>
            <% end %>
          <% end %>
          <%= button_to destroy_user_session_path, method: :delete,
            class: "text-red-300 hover:text-red-100 text-sm bg-transparent border-0 cursor-pointer" do %>
            🚪
          <% end %>
        </div>
      </div>

      <div class="flex md:h-screen md:overflow-hidden">
        <!-- SIDEBAR -->
        <%= render "layouts/customer_sidebar" %>

        <!-- MAIN -->
        <div class="flex-1 flex flex-col bg-gray-100 md:h-screen md:overflow-hidden">
          <!-- HEADER -->
          <%= render "layouts/customer_topbar" %>

          <!-- CONTENT -->
          <main class="flex-1 md:overflow-y-auto p-4 md:p-6">
            <% if notice %>
              <div class="mb-4 p-4 bg-green-100 text-green-800 rounded-lg"><%= notice %></div>
            <% end %>
            <% if alert %>
              <div class="mb-4 p-4 bg-red-100 text-red-800 rounded-lg"><%= alert %></div>
            <% end %>

            <%= yield %>
          </main>
        </div>
      </div>
    </body>
  <% else %>
    <!-- Guest / Non-customer: Original layout with navbar -->
    <body class="bg-gray-50 min-h-screen flex flex-col">
      <!-- Customer Navbar -->
      <%= render "layouts/customer_navbar" %>

      <main class="flex-1 p-0">
        <% if notice %>
          <div class="p-4 bg-green-100 text-green-800 rounded-lg mx-4 mt-4"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="p-4 bg-red-100 text-red-800 rounded-lg mx-4 mt-4"><%= alert %></div>
        <% end %>

        <%= yield %>
      </main>

      <% unless current_user %>
        <!-- Footer -->
        <%= render "layouts/customer_footer" %>
      <% end %>
    </body>
  <% end %>
</html>
