<% content_for :page_title, "Customer Details" %>

<div class="max-w-3xl mx-auto">
  <div class="flex items-center gap-4 mb-6">
    <%= link_to "← Back", subadmin_customers_path, class: "text-[#0d2c63] hover:underline" %>
    <h1 class="text-2xl font-bold text-gray-800"><%= @customer.display_name %></h1>
  </div>

  <div class="bg-white rounded-xl shadow p-6 mb-6">
    <div class="grid grid-cols-2 gap-4">
      <div>
        <p class="text-sm text-gray-500">Email</p>
        <p class="font-medium"><%= @customer.email %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Phone</p>
        <p class="font-medium"><%= @customer.contact.presence || "—" %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Total Orders</p>
        <p class="font-medium"><%= @customer.orders.count %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Member Since</p>
        <p class="font-medium"><%= @customer.created_at.strftime("%d %b %Y") %></p>
      </div>
    </div>
  </div>

  <h2 class="text-lg font-semibold mb-4">Recent Orders</h2>
  <% if @orders.any? %>
    <div class="bg-white rounded-xl shadow overflow-hidden">
      <table class="w-full text-left">
        <thead class="bg-gray-50">
          <tr>
            <th class="py-2 px-4">Order #</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr class="border-t">
              <td class="py-2 px-4">#<%= order.id %></td>
              <td>₹<%= order.total_amount %></td>
              <td>
                <span class="px-2 py-1 rounded-full text-xs font-medium <%= order.status_badge_class %>">
                  <%= order.status.titleize %>
                </span>
              </td>
              <td class="text-sm text-gray-500"><%= order.created_at.strftime("%d %b %Y") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-gray-500">No orders yet.</p>
  <% end %>
</div>
