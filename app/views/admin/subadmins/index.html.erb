<% content_for :page_title, "Subadmins" %>

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-3">
  <h1 class="text-xl md:text-2xl font-bold text-gray-800">Subadmins 🛡️</h1>
  <%= link_to "+ Create Subadmin", new_admin_subadmin_path,
    class: "bg-[#0d2c63] text-white px-4 py-2 rounded-lg hover:shadow-lg hover:-translate-y-0.5 transition text-sm font-medium shrink-0" %>
</div>

<!-- Desktop Table -->
<div class="hidden md:block bg-white rounded-xl shadow overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead class="bg-gray-50">
        <tr>
          <th class="py-3 px-4">Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Joined</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @subadmins.each do |subadmin| %>
          <tr class="border-t hover:bg-gray-50">
            <td class="py-3 px-4 font-medium"><%= subadmin.display_name %></td>
            <td><%= subadmin.email %></td>
            <td><%= subadmin.contact.presence || "—" %></td>
            <td class="text-sm text-gray-500"><%= subadmin.created_at.strftime("%d %b %Y") %></td>
            <td class="text-right px-4">
              <div class="flex gap-2 justify-end">
                <%= link_to "Edit", edit_admin_subadmin_path(subadmin),
                  class: "text-xs bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700" %>
                <%= button_to "Delete", admin_subadmin_path(subadmin),
                  method: :delete,
                  data: { turbo_confirm: "Are you sure?" },
                  class: "text-xs bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<!-- Mobile Cards -->
<div class="md:hidden space-y-3">
  <% @subadmins.each do |subadmin| %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
      <p class="font-bold text-gray-800 mb-0.5"><%= subadmin.display_name %></p>
      <p class="text-xs text-gray-500 mb-3"><%= subadmin.email %></p>
      <div class="grid grid-cols-2 gap-2 text-sm mb-3">
        <div>
          <p class="text-xs text-gray-400">Phone</p>
          <p class="font-medium"><%= subadmin.contact.presence || "—" %></p>
        </div>
        <div>
          <p class="text-xs text-gray-400">Joined</p>
          <p class="font-medium"><%= subadmin.created_at.strftime("%d %b %Y") %></p>
        </div>
      </div>
      <div class="flex gap-2 pt-3 border-t border-gray-100">
        <%= link_to "Edit", edit_admin_subadmin_path(subadmin),
          class: "flex-1 text-center text-xs bg-blue-600 text-white px-3 py-2 rounded-lg hover:bg-blue-700" %>
        <%= button_to "Delete", admin_subadmin_path(subadmin),
          method: :delete,
          data: { turbo_confirm: "Are you sure?" },
          class: "flex-1 text-xs bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-700 bg-transparent border-0 cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>
