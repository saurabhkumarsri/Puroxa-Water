<header class="bg-white border-b border-gray-200 px-6 py-4 flex justify-between items-center">
  <!-- LEFT -->
  <div class="flex items-center gap-4">
    <button class="md:hidden text-gray-500" onclick="document.getElementById('sidebar').classList.toggle('hidden')">
      ☰
    </button>

    <h1 class="text-xl font-bold text-gray-800">
      <%= content_for(:page_title) || "Dashboard" %>
    </h1>
  </div>

  <!-- RIGHT -->
  <div class="flex items-center gap-4">
    <div class="text-right hidden sm:block">
      <p class="text-sm text-gray-700 font-medium">
        <%= current_user&.display_name || "User" %>
      </p>
      <p class="text-xs text-gray-500"><%= current_user&.admin? ? "Administrator" : "Subadmin" %></p>
    </div>

    <div class="w-9 h-9 bg-[#0d2c63] rounded-full flex items-center justify-center text-white font-semibold">
      <%= current_user&.display_name&.first&.upcase || "A" %>
    </div>
  </div>
</header>
