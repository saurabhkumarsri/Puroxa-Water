<header class="hidden md:flex shrink-0 bg-white border-b border-gray-200 px-6 py-4 justify-between items-center">
  <!-- LEFT -->
  <div class="flex items-center gap-4">
    <button class="md:hidden text-gray-500" onclick="document.getElementById('mobile-sidebar-overlay').classList.remove('hidden')">
      ☰
    </button>

    <h1 class="text-xl font-bold text-gray-800">
      <%= content_for(:title) || "Dashboard" %>
    </h1>
  </div>

  <!-- RIGHT -->
  <div class="flex items-center gap-4">
    <%= render "shared/notification_bell", namespace: :vendor, variant: :dark %>

    <div class="text-right hidden sm:block">
      <p class="text-sm text-gray-700 font-medium">
        <%= current_user&.display_name || "User" %>
      </p>
      <p class="text-xs text-gray-500">Vendor</p>
    </div>

    <div class="w-9 h-9 bg-[#0d2c63] rounded-full flex items-center justify-center text-white font-semibold">
      <%= current_user&.display_name&.first&.upcase || "V" %>
    </div>
  </div>
</header>
