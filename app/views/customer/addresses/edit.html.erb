<% content_for :title, "Edit Address" %>

<div class="max-w-2xl mx-auto px-0 md:px-0">
  <h1 class="text-xl md:text-2xl font-bold text-gray-800 mb-4 md:mb-6">Edit Address ✏️</h1>

  <%= form_with model: @address, url: customer_address_path(@address), method: :patch, class: "bg-white rounded-xl shadow p-4 md:p-6 space-y-3 md:space-y-4" do |f| %>
    <div>
      <%= f.label :label, class: "block text-xs md:text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :label, class: "w-full border rounded-lg px-3 py-2 text-sm md:text-base" %>
    </div>

    <div>
      <%= f.label :address_line, class: "block text-xs md:text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :address_line, rows: 2, class: "w-full border rounded-lg px-3 py-2 text-sm md:text-base" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4">
      <div>
        <%= f.label :city, class: "block text-xs md:text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :city, class: "w-full border rounded-lg px-3 py-2 text-sm md:text-base" %>
      </div>
      <div>
        <%= f.label :state, class: "block text-xs md:text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :state, class: "w-full border rounded-lg px-3 py-2 text-sm md:text-base" %>
      </div>
    </div>

    <div>
      <%= f.label :pincode, class: "block text-xs md:text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :pincode, class: "w-full border rounded-lg px-3 py-2 text-sm md:text-base" %>
    </div>

    <div class="flex items-center gap-2">
      <%= f.check_box :is_default %>
      <%= f.label :is_default, "Set as default address", class: "text-xs md:text-sm" %>
    </div>

    <div class="flex flex-col sm:flex-row gap-2 md:gap-3 pt-2">
      <%= f.submit "Update Address",
        class: "bg-[#0d2c63] text-white px-4 py-2 rounded hover:scale-105 transition cursor-pointer text-sm md:text-base" %>
      <%= link_to "Cancel", customer_addresses_path,
        class: "px-4 py-2 border rounded hover:bg-gray-50 text-center text-sm md:text-base" %>
    </div>
  <% end %>
</div>
