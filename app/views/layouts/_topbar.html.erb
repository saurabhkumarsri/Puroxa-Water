<header class="bg-gray-900 border-b border-gray-800 px-6 py-4 flex justify-between items-center">

  <!-- LEFT -->
  <div class="flex items-center gap-4">
    <button class="md:hidden text-gray-400" onclick="document.getElementById('sidebar').classList.toggle('hidden')">
      ☰
    </button>

    <h1 class="text-xl font-bold text-white">
      Admin Dashboard
    </h1>
  </div>

  <!-- RIGHT -->
  <div class="flex items-center gap-4">

    <!-- USER -->
    <div class="text-right hidden sm:block">
      <p class="text-sm text-gray-300 font-medium">
        <%= current_user&.email || "Admin" %>
      </p>
      <p class="text-xs text-white">Administrator</p>
    </div>

    <!-- AVATAR -->
    <div class="w-9 h-9 bg-indigo-500 rounded-full flex items-center justify-center text-white font-semibold">
      <%= current_user&.email&.first&.upcase || "A" %>
    </div>

    <!-- LOGOUT -->
    <%#= link_to "Logout",
      destroy_user_session_path,
      data: { turbo_method: :delete, turbo_confirm: "Logout?" },
      class: "text-sm bg-red-600 hover:bg-red-700 px-4 py-2 rounded-lg text-white transition" %>

  </div>
</header>