<div class="min-h-screen flex items-center justify-center bg-gradient-to-b from-cyan-50 to-gray-50 px-4">
  <div class="bg-white p-6 md:p-8 rounded-xl shadow-lg w-full max-w-md">
    <div class="text-center mb-6">
      <h1 class="text-2xl md:text-3xl font-bold text-[#0d2c63]">Customer Login</h1>
      <p class="text-gray-500 mt-1 text-sm md:text-base">Sign in to order fresh water</p>
    </div>

    <%= form_with url: user_session_path, method: :post, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :user_email, name: "user[email]", class: "w-full border rounded-lg px-3 py-2 text-sm md:text-base", required: true %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :user_password, name: "user[password]", class: "w-full border rounded-lg px-3 py-2 text-sm md:text-base", required: true %>
      </div>

      <%= f.submit "Sign In",
        class: "w-full bg-[#0d2c63] text-white py-2.5 md:py-3 rounded-lg hover:scale-105 transition cursor-pointer text-sm md:text-base font-medium" %>
    <% end %>

    <div class="mt-4 text-center text-sm space-y-2">
      <p>Don't have an account?
        <%= link_to "Register", new_user_registration_path, class: "text-[#0d2c63] hover:underline font-medium" %>
      </p>
      <p>
        <%= link_to "← Back to Website", root_path, class: "text-gray-500 hover:text-[#0d2c63]" %>
      </p>
    </div>
  </div>
</div>
