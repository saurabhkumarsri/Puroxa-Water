<div class="w-full overflow-x-hidden bg-[#f8faff] text-[#0d2c63]">

<!-- HERO -->
<section class="relative w-full h-[80vh] overflow-hidden">
  <video autoplay muted loop playsinline class="absolute top-0 left-0 w-full h-full object-cover">
    <source src="<%= asset_path 'seawater.mp4' %>" type="video/mp4">
  </video>
  <div class="absolute inset-0 bg-black/50"></div>
  <div class="relative z-10 flex flex-col items-center justify-center h-full text-white text-center px-6">
    <h1 class="text-4xl md:text-6xl font-bold mb-4">Pure Water. Pure Life.</h1>
    <p class="text-lg md:text-xl mb-6">Premium Drinking Water for Home, Office & Events</p>
    <div class="flex flex-col sm:flex-row gap-4">
      <%= link_to "Order Now", customer_products_path,
        class: "bg-cyan-500 px-6 py-3 rounded-lg hover:scale-105 transition text-white font-medium text-center" %>
      <%= link_to "Become a Vendor", vendor_signup_path,
        class: "border border-white px-6 py-3 rounded-lg hover:bg-white hover:text-black transition font-medium text-center" %>
    </div>
  </div>
</section>

<!-- PRODUCTS -->
<section class="w-full px-6 md:px-16 py-16 text-center">
  <h2 class="text-3xl font-bold mb-12">Our Products</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
    <% products = [
      {name: "500ml Bottle", price: "₹10", img: "bottle.png"},
      {name: "1 Litre Bottle", price: "₹20", img: "bottle.png"},
      {name: "2 Litre Bottle", price: "₹40", img: "bottle.png"},
      {name: "20 Litre Jar", price: "₹80", img: "bottle.png"}
    ] %>

    <% products.each do |p| %>
      <div class="bg-white p-6 rounded-xl shadow hover:-translate-y-2 transition duration-300">
        <img src="<%= image_path p[:img] %>" class="h-44 mx-auto object-contain mb-4">
        <h3 class="font-semibold text-lg"><%= p[:name] %></h3>
        <p class="my-2 font-bold text-xl"><%= p[:price] %></p>
        <%= link_to "Buy Now", customer_products_path,
          class: "bg-[#0d2c63] text-white px-4 py-2 rounded hover:scale-105 transition inline-block" %>
      </div>
    <% end %>
  </div>
</section>

<!-- FEATURES -->
<section class="w-full bg-blue-50 py-16 text-center px-6 md:px-16">
  <h2 class="text-3xl font-bold mb-12">Why Choose Puroxa</h2>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
    <div class="bg-white p-6 rounded-xl shadow">
      <div class="text-3xl mb-2">💧</div>
      <p class="font-medium">RO Purified</p>
    </div>
    <div class="bg-white p-6 rounded-xl shadow">
      <div class="text-3xl mb-2">✅</div>
      <p class="font-medium">FSSAI Certified</p>
    </div>
    <div class="bg-white p-6 rounded-xl shadow">
      <div class="text-3xl mb-2">🌱</div>
      <p class="font-medium">Eco Friendly</p>
    </div>
    <div class="bg-white p-6 rounded-xl shadow">
      <div class="text-3xl mb-2">❄️</div>
      <p class="font-medium">Fresh Taste</p>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="w-full py-16 text-center px-6 md:px-16">
  <h2 class="text-3xl font-bold mb-12">How It Works</h2>
  <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
    <div class="bg-white p-6 shadow rounded-xl">
      <div class="text-4xl mb-3">1️⃣</div>
      <h3 class="font-bold">Choose</h3>
      <p class="text-gray-600 text-sm mt-2">Select your water bottle size</p>
    </div>
    <div class="bg-white p-6 shadow rounded-xl">
      <div class="text-4xl mb-3">2️⃣</div>
      <h3 class="font-bold">Order</h3>
      <p class="text-gray-600 text-sm mt-2">Place order with delivery address</p>
    </div>
    <div class="bg-white p-6 shadow rounded-xl">
      <div class="text-4xl mb-3">3️⃣</div>
      <h3 class="font-bold">Track</h3>
      <p class="text-gray-600 text-sm mt-2">Real-time order tracking</p>
    </div>
    <div class="bg-white p-6 shadow rounded-xl">
      <div class="text-4xl mb-3">4️⃣</div>
      <h3 class="font-bold">Enjoy</h3>
      <p class="text-gray-600 text-sm mt-2">Fresh water at your doorstep</p>
    </div>
  </div>
</section>

<!-- VENDOR CTA -->
<section class="w-full bg-blue-100 py-16 text-center px-6">
  <h2 class="text-3xl font-bold mb-6">Become a Vendor</h2>
  <p class="mb-8 text-gray-600 max-w-xl mx-auto">
    Grow your business with us & earn more profit. Join 500+ vendors across India.
  </p>
  <%= link_to "Join Now", vendor_signup_path,
    class: "bg-green-600 text-white px-6 py-3 rounded-lg hover:scale-105 transition inline-block" %>
</section>

<!-- TRUST -->
<section class="w-full py-16 text-center px-6">
  <div class="bg-blue-50 p-8 rounded-xl max-w-3xl mx-auto shadow">
    <h2 class="text-2xl font-bold mb-2">Trusted by 5000+ Customers</h2>
    <p class="mt-2 text-lg">⭐ 4.8 Rating | 1000+ Daily Orders | Pan India Delivery</p>
  </div>
</section>

</div>
