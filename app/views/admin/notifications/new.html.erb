<% content_for :page_title, "Send Notification" %>

<div class="max-w-3xl mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to admin_dashboard_path, class: "text-gray-500 hover:text-[#0d2c63] transition" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <h1 class="text-xl md:text-2xl font-bold text-gray-800">📢 Send Notification</h1>
  </div>

  <%= form_with url: admin_notifications_path, method: :post, local: true, class: "bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8" do |f| %>
    <!-- Title -->
    <div class="mb-5">
      <%= f.label :title, "Notification Title", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= f.text_field :title, required: true, class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#0d2c63] focus:ring-2 focus:ring-[#0d2c63]/20 outline-none transition text-sm", placeholder: "e.g. New Offer, Order Update..." %>
    </div>

    <!-- Body -->
    <div class="mb-5">
      <%= f.label :body, "Message", class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= f.text_area :body, class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#0d2c63] focus:ring-2 focus:ring-[#0d2c63]/20 outline-none transition text-sm resize-none", rows: 4, placeholder: "Write your message here..." %>
    </div>

    <!-- Select All Checkbox -->
    <div class="mb-4">
      <label class="flex items-center gap-2 cursor-pointer">
        <%= f.check_box "customer_ids[]", { value: "all", class: "w-4 h-4 rounded border-gray-300 text-[#0d2c63] focus:ring-[#0d2c63]" }, "all", nil %>
        <span class="text-sm font-semibold text-gray-700">Send to ALL customers</span>
      </label>
    </div>

    <!-- Customer List -->
    <div class="mb-6 max-h-64 overflow-y-auto border border-gray-200 rounded-xl p-3">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Or select specific customers:</p>
      <div class="space-y-2">
        <% @customers.each do |customer| %>
          <label class="flex items-center gap-3 p-2 rounded-lg hover:bg-gray-50 cursor-pointer transition">
            <%= f.check_box "customer_ids[]", { multiple: true, value: customer.id, class: "w-4 h-4 rounded border-gray-300 text-[#0d2c63] focus:ring-[#0d2c63]" }, customer.id, nil %>
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 bg-[#0d2c63]/10 rounded-full flex items-center justify-center text-[#0d2c63] font-bold text-xs">
                <%= customer.display_name.first.upcase %>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-800"><%= customer.display_name %></p>
                <p class="text-xs text-gray-500"><%= customer.contact %></p>
              </div>
            </div>
          </label>
        <% end %>
      </div>
    </div>

    <!-- Submit -->
    <%= f.submit "Send Notification", class: "w-full bg-[#0d2c63] text-white font-semibold py-3 rounded-xl hover:shadow-lg hover:-translate-y-0.5 transition cursor-pointer text-sm" %>
  <% end %>
</div>
