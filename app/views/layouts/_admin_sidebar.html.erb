        <h1 class="text-lg font-bold text-[#0d2c63]">Puroxa Admin</h1>
        <button onclick="document.getElementById('mobile-sidebar-overlay').classList.add('hidden')"
          class="text-gray-500 hover:text-gray-800 p-1">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <nav class="space-y-1">
        <%= link_to admin_dashboard_path,
          class: "flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-gray-100 transition #{controller_name == 'dashboards' && controller.class.name.start_with?('Admin::') ? 'bg-gray-100 font-medium' : ''}",
          onclick: "document.getElementById('mobile-sidebar-overlay').classList.add('hidden')" do %>
