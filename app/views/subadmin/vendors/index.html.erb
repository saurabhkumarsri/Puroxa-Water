<% content_for :page_title, "Vendors" %>

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-3">
  <h1 class="text-xl md:text-2xl font-bold text-gray-800">Vendors 🏪</h1>
</div>

<!-- Desktop Table -->
<div class="hidden md:block bg-white rounded-xl shadow overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead class="bg-gray-50">
        <tr>
          <th class="py-3 px-4">Shop Name</th>
          <th>Owner</th>
          <th>Contact</th>
          <th>Status</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @vendors.each do |vendor| %>
          <tr class="border-t hover:bg-gray-50">
            <td class="py-3 px-4 font-medium"><%= vendor.shop_name %></td>
            <td><%= vendor.user.display_name %></td>
            <td><%= vendor.contact_number || vendor.user.contact %></td>
            <td>
              <% if vendor.approved? %>
                <span class="px-2 py-1 bg-green-100 text-green-800 rounded-full text-xs font-medium">Approved</span>
              <% elsif vendor.approved == false %>
                <span class="px-2 py-1 bg-red-100 text-red-800 rounded-full text-xs font-medium">Rejected</span>
              <% else %>
                <span class="px-2 py-1 bg-yellow-100 text-yellow-800 rounded-full text-xs font-medium">Pending</span>
              <% end %>
            </td>
            <td class="text-right px-4">
              <%= link_to "View", subadmin_vendor_path(vendor), class: "text-[#0d2c63] hover:underline text-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<!-- Mobile Cards -->
<div class="md:hidden space-y-3">
  <% @vendors.each do |vendor| %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
      <div class="flex justify-between items-start mb-2">
        <div>
          <p class="font-bold text-gray-800"><%= vendor.shop_name %></p>
          <p class="text-xs text-gray-500 mt-0.5"><%= vendor.user.display_name %> · <%= vendor.contact_number || vendor.user.contact %></p>
        </div>
        <% if vendor.approved? %>
          <span class="px-2 py-1 bg-green-100 text-green-800 rounded-full text-xs font-medium">Approved</span>
        <% elsif vendor.approved == false %>
          <span class="px-2 py-1 bg-red-100 text-red-800 rounded-full text-xs font-medium">Rejected</span>
        <% else %>
          <span class="px-2 py-1 bg-yellow-100 text-yellow-800 rounded-full text-xs font-medium">Pending</span>
        <% end %>
      </div>
      <div class="pt-3 border-t border-gray-100">
        <%= link_to "View Details", subadmin_vendor_path(vendor), class: "block text-center text-xs bg-[#0d2c63] text-white px-3 py-2 rounded-lg hover:opacity-90" %>
      </div>
    </div>
  <% end %>
</div>
