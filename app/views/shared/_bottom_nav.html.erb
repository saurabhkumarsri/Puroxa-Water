<%# Bottom navigation bar — mobile-only, app-style tab bar
    Renders role-specific tabs. Pass `namespace:` to choose the set:
      :customer (default), :vendor, :admin

    Features:
      - Fixed to bottom on mobile, hidden on md+ (where the sidebar takes over)
      - Active tab highlighted with brand gradient
      - Backdrop blur for that native-app feel
      - Safe-area padding so iOS home-bar doesn't cover the bar
      - 4 tabs per portal, all with SVG icons + labels

    Drop into any layout just before the closing </body>. Make sure to add
    `pb-16 md:pb-0` to the main content wrapper so content isn't covered. %>

<%
  namespace = local_assigns.fetch(:namespace, :customer)
  current_controller = controller_name
  current_action = action_name
  current_path = request.path

  # Helper: is this tab "active"?
  active = ->(controller, actions = nil) {
    controller == current_controller && (actions.nil? || Array(actions).include?(current_action))
  }

  # Tab definitions per namespace
  tabs_by_ns = {
    customer: [
      {
        label: "Home",
        path: customer_dashboard_path,
        match_controller: "dashboards",
        icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
      },
      {
        label: "Orders",
        path: customer_orders_path,
        match_controller: "orders",
        icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
      },
      {
        label: "Alerts",
        path: customer_notifications_path,
        match_controller: "notifications",
        icon: "M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
      },
      {
        label: "Profile",
        path: customer_profile_path,
        match_controller: "profiles",
        icon: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
      }
    ],
    vendor: [
      {
        label: "Home",
        path: vendor_dashboard_path,
        match_controller: "dashboards",
        icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
      },
      {
        label: "Orders",
        path: vendor_orders_path,
        match_controller: "orders",
        icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
      },
      {
        label: "Alerts",
        path: vendor_notifications_path,
        match_controller: "notifications",
        icon: "M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
      },
      {
        label: "Profile",
        path: vendor_profile_path,
        match_controller: "profiles",
        icon: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
      }
    ],
    admin: [
      {
        label: "Home",
        path: admin_dashboard_path,
        match_controller: "dashboards",
        icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
      },
      {
        label: "Orders",
        path: admin_orders_path,
        match_controller: "orders",
        icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
      },
      {
        label: "Alerts",
        path: admin_notifications_path,
        match_controller: "notifications",
        icon: "M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
      },
      {
        label: "Profile",
        path: admin_settings_path,
        match_controller: "settings",
        icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z"
      }
    ]
  }

  tabs = tabs_by_ns[namespace.to_sym] || tabs_by_ns[:customer]
%>

<nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md
            border-t border-gray-200 shadow-[0_-2px_10px_rgba(0,0,0,0.04)]
            pb-[env(safe-area-inset-bottom)]"
     aria-label="<%= namespace.to_s.titleize %> navigation">
  <ul class="grid grid-cols-4 h-14">
    <% tabs.each do |tab| %>
      <% is_active = active.call(tab[:match_controller]) %>
      <li>
        <%= link_to tab[:path],
              class: "group flex flex-row items-center justify-center h-full gap-1.5 px-1 transition
                      #{ is_active ? 'text-[#0d2c63]' : 'text-gray-500 hover:text-gray-900' }",
              aria: { current: is_active ? "page" : nil } do %>
          <span class="relative flex items-center justify-center w-6 h-6 rounded-full transition shrink-0
                       <%= is_active ? 'bg-gradient-to-r from-sky-100 to-cyan-100' : '' %>">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="<%= is_active ? '2.5' : '2' %>" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="<%= tab[:icon] %>"/>
            </svg>
            <% if is_active %>
              <span class="absolute -top-0.5 -right-0.5 w-1.5 h-1.5 rounded-full bg-gradient-to-r from-sky-500 to-cyan-400"></span>
            <% end %>
          </span>
          <span class="text-[11px] font-<%= is_active ? 'bold' : 'semibold' %> tracking-wide leading-none whitespace-nowrap">
            <%= tab[:label] %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav>
