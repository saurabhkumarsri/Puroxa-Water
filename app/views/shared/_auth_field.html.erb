<%#
  Reusable form field with icon, label, and inline error display.

  Locals:
    form     - the form builder (f)
    name     - the field name (Symbol)
    label    - human label string
    type     - :text (default) | :email | :password | :tel | :textarea
    icon     - SVG path data (string) drawn inside the input on the left
    placeholder - placeholder text
    autocomplete - autocomplete attr value
    required - boolean
    rows     - for textarea

  Renders a labelled field with the icon, plus an error message slot that
  only appears if form.object has errors on this attribute. Avoids the
  empty-red-box look on first render.
%>
<%
  form     = local_assigns[:form]
  name     = local_assigns[:name]
  label    = local_assigns[:label] || name.to_s.titleize
  type     = (local_assigns[:type] || :text).to_sym
  icon     = local_assigns[:icon]
  placeholder = local_assigns[:placeholder] || label
  autocomplete = local_assigns[:autocomplete]
  required = local_assigns.fetch(:required, false)
  rows     = local_assigns[:rows] || 3

  has_error = form.object&.errors&.[](name)&.any?
  wrapper_class = has_error ? "border-rose-300 bg-rose-50/40 focus-within:ring-rose-300 focus-within:border-rose-400" : "border-gray-200 bg-white focus-within:ring-sky-300 focus-within:border-sky-400"
%>

<div>
  <%= form.label name, label, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
  <% if type == :textarea %>
    <div class="relative flex items-start transition rounded-xl border <%= wrapper_class %> focus-within:ring-2 focus-within:ring-offset-0 overflow-hidden">
      <% if icon.present? %>
        <span class="pl-3 pt-3 text-gray-400 shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>"/>
          </svg>
        </span>
      <% end %>
      <%= form.text_area name, rows: rows, placeholder: placeholder, required: required,
            class: "flex-1 px-3 py-2.5 bg-transparent outline-none text-sm md:text-base placeholder-gray-400 resize-none" %>
    </div>
  <% elsif type == :password %>
    <div data-controller="password-visibility"
         class="relative flex items-center transition rounded-xl border <%= wrapper_class %> focus-within:ring-2 focus-within:ring-offset-0 overflow-hidden">
      <% if icon.present? %>
        <span class="pl-3 text-gray-400 shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>"/>
          </svg>
        </span>
      <% end %>
      <%= form.password_field name, placeholder: placeholder, required: required, autocomplete: autocomplete,
            data: { password_visibility_target: "input" },
            class: "flex-1 px-3 py-2.5 bg-transparent outline-none text-sm md:text-base placeholder-gray-400" %>
      <button type="button"
              data-action="password-visibility#toggle"
              aria-label="Toggle password visibility"
              class="px-3 text-gray-400 hover:text-gray-600 transition shrink-0">
        <%# Show icon (default state) — eye open %>
        <svg data-password-visibility-target="iconShow" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
        </svg>
        <%# Hide icon (hidden by default) — eye with slash %>
        <svg data-password-visibility-target="iconHide" class="hidden w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
        </svg>
      </button>
    </div>
  <% else %>
    <div class="relative flex items-center transition rounded-xl border <%= wrapper_class %> focus-within:ring-2 focus-within:ring-offset-0 overflow-hidden">
      <% if icon.present? %>
        <span class="pl-3 text-gray-400 shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>"/>
          </svg>
        </span>
      <% end %>
      <%= form.text_field name, type: type, placeholder: placeholder, required: required, autocomplete: autocomplete,
            class: "flex-1 px-3 py-2.5 bg-transparent outline-none text-sm md:text-base placeholder-gray-400" %>
    </div>
  <% end %>

  <% if has_error %>
    <p class="mt-1 text-xs text-rose-600 flex items-center gap-1">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <%= form.object.errors.full_messages_for(name).first %>
    </p>
  <% end %>
</div>
