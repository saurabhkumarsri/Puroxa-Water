<% content_for :page_title, "Edit Customer" %>

<div class="max-w-xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">Edit Customer ✏️</h1>

  <%= form_with model: @customer, url: admin_customer_path(@customer), method: :patch, class: "bg-white rounded-xl shadow p-6 space-y-4" do |f| %>
    <div>
      <%= f.label :shop_name, "Shop Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :shop_name, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div>
      <%= f.label :first_name, "Owner Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :first_name, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div>
      <%= f.label :contact, "Phone", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :contact, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div>
      <%= f.label :area, "Area / Route", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :area, class: "w-full border rounded-lg px-3 py-2", placeholder: "e.g. Main Market, Gandhi Road" %>
    </div>

    <div>
      <%= f.label :gst_number, "GST Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :gst_number, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div>
      <%= f.label :credit_limit, "Credit Limit (₹)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :credit_limit, class: "w-full border rounded-lg px-3 py-2", step: 1 %>
    </div>

    <div class="flex gap-3 pt-2">
      <%= f.submit "Save Changes",
        class: "bg-[#0d2c63] text-white px-4 py-2 rounded hover:scale-105 transition cursor-pointer" %>
      <%= link_to "Cancel", admin_customers_path,
        class: "px-4 py-2 border rounded hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
