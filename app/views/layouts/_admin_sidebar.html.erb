<!-- Desktop Sidebar -->
<aside id="sidebar"
  class="w-64 bg-white h-screen overflow-y-auto border-r border-gray-200 z-40 hidden md:flex flex-col shrink-0">

  <div class="p-6 border-b">
    <h1 class="text-xl font-bold text-[#0d2c63]">Puroxa Admin</h1>
  </div>

  <nav class="p-4 space-y-1 flex-1">
    <%= link_to admin_dashboard_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'dashboards' && controller.class.name.start_with?('Admin::') ? 'bg-gray-100 font-medium' : ''}" do %>
      📊 <span>Dashboard</span>
    <% end %>

    <%= link_to admin_workers_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'workers' && controller.class.name.start_with?('Admin::') ? 'bg-gray-100 font-medium' : ''}" do %>
      👷 <span>Workers</span>
    <% end %>

    <%= link_to admin_vendors_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'vendors' && controller.class.name.start_with?('Admin::') ? 'bg-gray-100 font-medium' : ''}" do %>
      🏪 <span>Vendors</span>
    <% end %>

    <%= link_to admin_customers_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'customers' && controller.class.name.start_with?('Admin::') ? 'bg-gray-100 font-medium' : ''}" do %>
      👥 <span>Customers</span>
    <% end %>

    <%= link_to admin_orders_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'orders' && controller.class.name.start_with?('Admin::') ? 'bg-gray-100 font-medium' : ''}" do %>
      📦 <span>Orders</span>
    <% end %>

    <%= link_to admin_products_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'products' && controller.class.name.start_with?('Admin::') ? 'bg-gray-100 font-medium' : ''}" do %>
      🧴 <span>Products</span>
    <% end %>

    <%= link_to admin_raw_materials_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'raw_materials' && controller.class.name.start_with?('Admin::') ? 'bg-gray-100 font-medium' : ''}" do %>
      📦 <span>Inventory</span>
    <% end %>

    <%= link_to admin_discounts_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'discounts' && controller.class.name.start_with?('Admin::') ? 'bg-gray-100 font-medium' : ''}" do %>
      🏷️ <span>Discounts</span>
    <% end %>

    <%= link_to admin_daily_sales_report_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'reports' && controller.class.name.start_with?('Admin::') ? 'bg-gray-100 font-medium' : ''}" do %>
      📈 <span>Reports</span>
    <% end %>

    <%= link_to admin_daily_collection_report_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'reports' && controller.class.name.start_with?('Admin::') && action_name == 'daily_collection' ? 'bg-gray-100 font-medium' : ''}" do %>
      💰 <span>Daily Collection</span>
    <% end %>

    <%= link_to admin_subadmins_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'subadmins' && controller.class.name.start_with?('Admin::') ? 'bg-gray-100 font-medium' : ''}" do %>
      🛡️ <span>Subadmins</span>
    <% end %>

    <%= link_to admin_settings_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'settings' && controller.class.name.start_with?('Admin::') ? 'bg-gray-100 font-medium' : ''}" do %>
      ⚙️ <span>Settings</span>
    <% end %>

    <hr class="my-4 border-gray-200">

    <% logout_path = current_user&.admin? ? admin_logout_path : subadmin_logout_path %>
    <%= button_to logout_path, method: :delete,
      class: "w-full flex items-center gap-3 px-4 py-2 rounded-lg text-red-600 hover:bg-red-50 transition text-left bg-transparent border-0 cursor-pointer" do %>
      🚪 <span>Logout</span>
    <% end %>
  </nav>
</aside>

<!-- Mobile Sidebar Overlay -->
<div id="mobile-sidebar-overlay" class="hidden fixed inset-0 z-[60]">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/50"
    onclick="document.getElementById('mobile-sidebar-overlay').classList.add('hidden')"></div>

  <!-- Mobile Drawer -->
