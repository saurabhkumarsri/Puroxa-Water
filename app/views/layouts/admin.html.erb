<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || content_for(:page_title) || "Puroxa Water - Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1, viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32">
    <meta property="og:title" content="<%= content_for(:title) || 'Puroxa Water - Admin' %>">
    <meta property="og:description" content="Puroxa Water Admin Panel">
    <meta property="og:image" content="<%= request.base_url %>/icons/icon-512.png">

    <%= render "shared/pwa_head" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100 md:h-screen md:overflow-hidden" data-controller="service-worker">
    <!-- Mobile Header -->
    <div class="md:hidden bg-[#0d2c63] text-white px-4 py-3 flex items-center justify-between sticky top-0 z-50">
      <button onclick="document.getElementById('mobile-sidebar-overlay').classList.remove('hidden')"
        class="text-white p-1">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
      <span class="font-semibold flex-1 text-center"><%= content_for(:title) || content_for(:page_title) || "Puroxa Admin" %></span>
      <div class="flex items-center gap-1">
        <%= render "shared/notification_bell", namespace: :admin, variant: :light %>
        <%= button_to admin_logout_path, method: :delete,
          class: "text-red-300 hover:text-red-100 text-sm bg-transparent border-0 cursor-pointer p-2" do %>
          🚪
        <% end %>
      </div>
    </div>

    <div class="flex md:h-screen md:overflow-hidden">
      <!-- SIDEBAR -->
      <%= render "layouts/admin_sidebar" %>

      <!-- MAIN -->
      <div class="flex-1 flex flex-col bg-gray-100 md:h-screen md:overflow-hidden">
        <!-- HEADER -->
        <%= render "layouts/admin_topbar" %>

        <!-- CONTENT -->
        <main class="flex-1 md:overflow-y-auto p-4 md:p-6">
          <% if notice %>
            <div class="mb-4 p-4 bg-green-100 text-green-800 rounded-lg"><%= notice %></div>
          <% end %>
          <% if alert %>
            <div class="mb-4 p-4 bg-red-100 text-red-800 rounded-lg"><%= alert %></div>
          <% end %>

          <%= yield %>
        </main>
      </div>
    </div>

    <%= render "shared/pwa_install_prompt" %>
  </body>
</html>
