<!-- Desktop Sidebar -->
<aside id="sidebar"
  class="w-64 bg-white h-screen overflow-y-auto border-r border-gray-200 z-40 hidden md:flex flex-col shrink-0">

  <div class="p-6 border-b">
    <h1 class="text-xl font-bold text-[#0d2c63]">Puroxa Water</h1>
    <p class="text-xs text-gray-400 mt-0.5">Customer Panel</p>
  </div>

  <nav class="p-4 space-y-1 flex-1">
    <%= link_to customer_dashboard_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'dashboards' && controller.class.name.start_with?('Customer::') ? 'bg-gray-100 font-medium' : ''}" do %>
      📊 <span>Dashboard</span>
    <% end %>

    <%= link_to customer_orders_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'orders' && controller.class.name.start_with?('Customer::') ? 'bg-gray-100 font-medium' : ''}" do %>
      📦 <span>My Orders</span>
    <% end %>

    <%= link_to customer_products_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'products' && controller.class.name.start_with?('Customer::') ? 'bg-gray-100 font-medium' : ''}" do %>
      🛒 <span>Order Water</span>
    <% end %>

    <%= link_to customer_profile_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'profiles' && controller.class.name.start_with?('Customer::') ? 'bg-gray-100 font-medium' : ''}" do %>
      👤 <span>Profile</span>
    <% end %>

    <%= link_to customer_addresses_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'addresses' && controller.class.name.start_with?('Customer::') ? 'bg-gray-100 font-medium' : ''}" do %>
      📍 <span>Addresses</span>
    <% end %>

    <%= link_to customer_notifications_path,
      class: "flex items-center gap-3 px-4 py-2 rounded-lg text-gray-700 hover:bg-gray-100 transition #{controller_name == 'notifications' && controller.class.name.start_with?('Customer::') ? 'bg-gray-100 font-medium' : ''}" do %>
      🔔 <span>Notifications</span>
      <% unread_sidebar = current_user.notifications.unread.count rescue 0 %>
      <% if unread_sidebar > 0 %>
        <span class="ml-auto bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full min-w-[20px] text-center"><%= unread_sidebar > 9 ? "9+" : unread_sidebar %></span>
      <% end %>
    <% end %>

    <hr class="my-4 border-gray-200">

    <%= button_to destroy_user_session_path, method: :delete,
      class: "w-full flex items-center gap-3 px-4 py-2 rounded-lg text-red-600 hover:bg-red-50 transition text-left bg-transparent border-0 cursor-pointer" do %>
      🚪 <span>Logout</span>
    <% end %>
  </nav>
</aside>

<!-- Mobile Sidebar Overlay -->
<div id="mobile-sidebar-overlay" class="hidden fixed inset-0 z-[60]">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/50"
    onclick="document.getElementById('mobile-sidebar-overlay').classList.add('hidden')"></div>

  <!-- Mobile Drawer -->
  <div class="absolute left-0 top-0 bottom-0 w-[280px] max-w-[80vw] bg-white border-r border-gray-200 overflow-y-auto shadow-2xl">
    <div class="p-5">
      <div class="flex items-center justify-between mb-6 pb-4 border-b">
        <div>
          <h1 class="text-lg font-bold text-[#0d2c63]">Puroxa Water</h1>
          <p class="text-xs text-gray-400">Customer Panel</p>
        </div>
        <button onclick="document.getElementById('mobile-sidebar-overlay').classList.add('hidden')"
          class="text-gray-500 hover:text-gray-800 p-1">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <nav class="space-y-1">
        <%= link_to customer_dashboard_path,
          class: "flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-gray-100 transition #{controller_name == 'dashboards' && controller.class.name.start_with?('Customer::') ? 'bg-gray-100 font-medium' : ''}",
          onclick: "document.getElementById('mobile-sidebar-overlay').classList.add('hidden')" do %>
          📊 <span>Dashboard</span>
        <% end %>

        <%= link_to customer_orders_path,
          class: "flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-gray-100 transition #{controller_name == 'orders' && controller.class.name.start_with?('Customer::') ? 'bg-gray-100 font-medium' : ''}",
          onclick: "document.getElementById('mobile-sidebar-overlay').classList.add('hidden')" do %>
          📦 <span>My Orders</span>
        <% end %>

        <%= link_to customer_products_path,
          class: "flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-gray-100 transition #{controller_name == 'products' && controller.class.name.start_with?('Customer::') ? 'bg-gray-100 font-medium' : ''}",
          onclick: "document.getElementById('mobile-sidebar-overlay').classList.add('hidden')" do %>
          🛒 <span>Order Water</span>
        <% end %>

        <%= link_to customer_profile_path,
          class: "flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-gray-100 transition #{controller_name == 'profiles' && controller.class.name.start_with?('Customer::') ? 'bg-gray-100 font-medium' : ''}",
          onclick: "document.getElementById('mobile-sidebar-overlay').classList.add('hidden')" do %>
          👤 <span>Profile</span>
        <% end %>

        <%= link_to customer_addresses_path,
          class: "flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-gray-100 transition #{controller_name == 'addresses' && controller.class.name.start_with?('Customer::') ? 'bg-gray-100 font-medium' : ''}",
          onclick: "document.getElementById('mobile-sidebar-overlay').classList.add('hidden')" do %>
          📍 <span>Addresses</span>
        <% end %>

        <%= link_to customer_notifications_path,
          class: "flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-gray-100 transition #{controller_name == 'notifications' && controller.class.name.start_with?('Customer::') ? 'bg-gray-100 font-medium' : ''}",
          onclick: "document.getElementById('mobile-sidebar-overlay').classList.add('hidden')" do %>
          🔔 <span>Notifications</span>
          <% unread_mobile = current_user.notifications.unread.count rescue 0 %>
          <% if unread_mobile > 0 %>
            <span class="ml-auto bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full min-w-[20px] text-center"><%= unread_mobile > 9 ? "9+" : unread_mobile %></span>
          <% end %>
        <% end %>

        <hr class="my-4 border-gray-200">

        <%= button_to destroy_user_session_path, method: :delete,
          class: "w-full flex items-center gap-3 px-3 py-3 rounded-lg text-red-600 hover:bg-red-50 transition text-left bg-transparent border-0 cursor-pointer" do %>
          🚪 <span>Logout</span>
        <% end %>
      </nav>
    </div>
  </div>
</div>
