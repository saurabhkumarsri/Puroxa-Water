<% content_for(:title) { "Sign in — Puroxa Water" } %>

<%# Reuses the customer-facing application layout (with navbar + footer).
    Only the inner card is redesigned for a more focused, attractive look. %>

<div class="min-h-[calc(100vh-160px)] flex items-center justify-center px-4 py-10 bg-gradient-to-br from-sky-50 via-white to-cyan-50">
  <div class="w-full max-w-md">

    <!-- Card -->
    <div class="bg-white/90 backdrop-blur-md rounded-3xl shadow-2xl border border-gray-100 overflow-hidden">

      <!-- Top accent strip -->
      <div class="h-1.5 bg-gradient-to-r from-[#0d2c63] via-sky-500 to-cyan-400"></div>

      <div class="p-7 md:p-9">
        <!-- Header -->
        <div class="text-center mb-7">
          <div class="inline-flex w-14 h-14 rounded-2xl bg-gradient-to-br from-[#0d2c63] to-cyan-500 items-center justify-center shadow-lg shadow-sky-200 mb-4">
            <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.69l5.66 5.66a8 8 0 11-11.32 0L12 2.69z"/>
            </svg>
          </div>
          <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight">Welcome back</h1>
          <p class="text-sm text-gray-500 mt-1.5">Sign in to order fresh water</p>
        </div>

        <%= form_with url: user_session_path, method: :post, html: { class: "space-y-4" } do |f| %>
          <%= render "shared/auth_field",
                form: f,
                name: :user_email,
                type: :text,
                label: "Email or Mobile",
                placeholder: "you@example.com or 9876543210",
                autocomplete: "username",
                required: true,
                icon: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" %>

          <%= render "shared/auth_field",
                form: f,
                name: :user_password,
                type: :password,
                label: "Password",
                placeholder: "••••••••",
                autocomplete: "current-password",
                required: true,
                icon: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" %>

          <div class="flex items-center justify-between text-sm">
            <label class="inline-flex items-center gap-2 text-gray-600 cursor-pointer select-none">
              <%= f.check_box :remember_me, class: "w-4 h-4 rounded border-gray-300 text-[#0d2c63] focus:ring-[#0d2c63]" %>
              <span>Remember me</span>
            </label>
            <%= link_to "Forgot password?", new_user_password_path, class: "text-[#0d2c63] hover:text-sky-600 font-medium" %>
          </div>

          <%= f.submit "Sign in",
                class: "w-full mt-2 py-3 rounded-xl bg-gradient-to-r from-[#0d2c63] to-sky-600 text-white font-semibold shadow-lg shadow-sky-200 hover:shadow-xl hover:from-[#0d2c63] hover:to-sky-500 hover:-translate-y-0.5 transition cursor-pointer" %>
        <% end %>

        <!-- Divider -->
        <div class="my-6 flex items-center gap-3 text-xs text-gray-400">
          <div class="flex-1 h-px bg-gray-200"></div>
          <span>OR</span>
          <div class="flex-1 h-px bg-gray-200"></div>
        </div>

        <!-- Bottom CTA -->
        <div class="text-center text-sm text-gray-600">
          New to Puroxa?
          <%= link_to "Create an account", new_user_registration_path,
                class: "text-[#0d2c63] hover:text-sky-600 font-semibold ml-1" %>
        </div>
      </div>
    </div>

    <!-- Vendor cross-link -->
    <p class="text-center text-xs text-gray-500 mt-6">
      Are you a vendor?
      <%= link_to "Vendor login →", vendor_login_path, class: "text-cyan-600 hover:underline font-medium" %>
    </p>
  </div>
</div>
