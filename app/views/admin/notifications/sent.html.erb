<% content_for :page_title, "Sent Notifications" %>

<div class="max-w-4xl mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to admin_dashboard_path, class: "text-gray-500 hover:text-[#0d2c63] transition" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <h1 class="text-xl md:text-2xl font-bold text-gray-800">📨 Sent Notifications</h1>
    <%= link_to "+ Send New", admin_new_notification_path, class: "ml-auto text-sm bg-[#0d2c63] text-white px-4 py-2 rounded-lg hover:shadow transition" %>
  </div>

  <% if @grouped.present? %>
    <div class="space-y-3">
      <% @grouped.each do |(title, body), notifications| %>
        <% read_count = notifications.count(&:read?) %>
        <% total = notifications.size %>
        <% latest = notifications.max_by(&:created_at) %>
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 md:p-5 transition hover:shadow-md">
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <h3 class="font-semibold text-sm text-gray-800 mb-1"><%= title %></h3>
              <% if body.present? %>
                <p class="text-sm text-gray-500 mb-2 break-words"><%= body %></p>
              <% end %>
              <div class="flex items-center gap-3 text-xs text-gray-400 flex-wrap">
                <span>Sent to <%= total %> customer<%= 's' unless total == 1 %></span>
                <span>•</span>
                <span><%= time_ago_in_words(latest.created_at) %> ago</span>
              </div>
            </div>
            <div class="shrink-0">
              <span class="inline-flex items-center gap-1 text-xs font-medium px-2.5 py-1 rounded-full <%= read_count == total ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' %>">
                <% if read_count == total %>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <% else %>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <% end %>
                <%= read_count %>/<%= total %> seen
              </span>
            </div>
          </div>

          <!-- Per-customer read status -->
          <div class="mt-3 pt-3 border-t border-gray-100 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
            <% notifications.sort_by { |n| n.customer&.display_name&.downcase || '' }.each do |n| %>
              <div class="flex items-center gap-2 text-xs">
                <span class="w-2 h-2 rounded-full flex-shrink-0 <%= n.read? ? 'bg-green-500' : 'bg-gray-300' %>"></span>
                <span class="truncate <%= n.read? ? 'text-gray-700' : 'text-gray-400' %>"><%= n.customer&.display_name || "Unknown" %></span>
                <% if n.read? %>
                  <span class="ml-auto text-[10px] text-green-600 whitespace-nowrap">seen</span>
                <% else %>
                  <span class="ml-auto text-[10px] text-gray-400 whitespace-nowrap">pending</span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-10 text-center">
      <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl">📨</div>
      <p class="text-gray-500 text-lg mb-2">No notifications sent yet</p>
      <%= link_to "Send Your First Notification", admin_new_notification_path, class: "text-[#0d2c63] font-medium hover:underline" %>
    </div>
  <% end %>
</div>
