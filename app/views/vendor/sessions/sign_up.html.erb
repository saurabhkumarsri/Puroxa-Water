<!-- Signup Card -->
<div class="w-full max-w-lg bg-white/90 backdrop-blur-md p-10 rounded-3xl shadow-2xl border border-gray-200">

  <!-- Header -->
  <h1 class="text-5xl font-extrabold text-center text-cyan-700 mb-2">PUROXA</h1>
  <p class="text-center text-gray-500 mb-10">Create Shop / Customer Account</p>

<%= form_with model: @form,
              url: vendor_signup_path,
              scope: :vendor_signup_form,
              local: true do |f| %>

  <div class="mb-4">
    <%= f.label :shop_name, "Shop Name" %>
    <%= f.text_field :shop_name, class: "w-full px-4 py-3 border rounded-xl" %>
  </div>

  <div class="mb-4">
    <%= f.label :name, "Owner Name" %>
    <%= f.text_field :name, class: "w-full px-4 py-3 border rounded-xl" %>
  </div>

  <div class="mb-4">
    <%= f.label :email, "Email" %>
    <%= f.email_field :email, class: "w-full px-4 py-3 border rounded-xl" %>
  </div>

  <div class="mb-4">
    <%= f.label :contact_number, "Mobile Number" %>
    <%= f.telephone_field :contact, class: "w-full px-4 py-3 border rounded-xl" %>
  </div>

  <div class="mb-4">
    <%= f.label :password, "Password" %>
    <%= f.password_field :password, class: "w-full px-4 py-3 border rounded-xl" %>
  </div>

  <div class="mb-6">
    <%= f.label :address, "Shop Address" %>
    <%= f.text_area :address, rows: 3, class: "w-full px-4 py-3 border rounded-xl" %>
  </div>

  <%= f.submit "Create Account", class: "w-full py-3 bg-cyan-500 text-white rounded-xl" %>

<% end %>
</div>