        <%= link_to admin_raw_materials_path,
          class: "flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-gray-100 transition #{controller_name == 'raw_materials' && controller.class.name.start_with?('Admin::') ? 'bg-gray-100 font-medium' : ''}",
          onclick: "document.getElementById('mobile-sidebar-overlay').classList.add('hidden')" do %>
