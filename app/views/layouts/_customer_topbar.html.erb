<header class="hidden md:flex shrink-0 bg-white border-b border-gray-200 px-6 py-4 justify-between items-center">
  <!-- LEFT -->
  <div class="flex items-center gap-4">
    <button class="md:hidden text-gray-500" onclick="document.getElementById('mobile-sidebar-overlay').classList.remove('hidden')">
      ☰
    </button>

    <h1 class="text-xl font-bold text-gray-800">
      <%= content_for(:title) || "Dashboard" %>
    </h1>
  </div>

  <!-- RIGHT -->
  <div class="flex items-center gap-3 md:gap-4">
    <!-- Notification Bell -->
    <%= link_to customer_notifications_path, class: "relative p-2 text-gray-500 hover:text-[#0d2c63] hover:bg-blue-50 rounded-lg transition" do %>
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
      </svg>
      <% unread = current_user&.notifications&.unread&.count || 0 %>
      <% if unread > 0 %>
        <span class="absolute top-1 right-1 w-4 h-4 bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center">
          <%= unread > 9 ? "9+" : unread %>
        </span>
      <% end %>
    <% end %>

    <div class="h-6 w-px bg-gray-200 hidden sm:block"></div>

    <div class="text-right hidden sm:block">
      <p class="text-sm text-gray-700 font-medium">
        <%= current_user&.display_name || "User" %>
      </p>
      <p class="text-xs text-gray-500">Customer</p>
    </div>

    <div class="w-9 h-9 bg-[#0d2c63] rounded-full flex items-center justify-center text-white font-semibold">
      <%= current_user&.display_name&.first&.upcase || "C" %>
    </div>
  </div>
</header>
