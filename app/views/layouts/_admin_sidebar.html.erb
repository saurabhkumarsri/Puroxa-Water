        <% end %>

        <%= link_to admin_discounts_path,
          class: "flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-gray-100 transition #{controller_name == 'discounts' && controller.class.name.start_with?('Admin::') ? 'bg-gray-100 font-medium' : ''}",
          onclick: "document.getElementById('mobile-sidebar-overlay').classList.add('hidden')" do %>
          🏷️ <span>Discounts</span>
        <% end %>

        <%= link_to admin_daily_sales_report_path,
          class: "flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-gray-100 transition #{controller_name == 'reports' && controller.class.name.start_with?('Admin::') ? 'bg-gray-100 font-medium' : ''}",
          onclick: "document.getElementById('mobile-sidebar-overlay').classList.add('hidden')" do %>
          📈 <span>Reports</span>
        <% end %>

        <%= link_to admin_daily_collection_report_path,
          class: "flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-gray-100 transition #{controller_name == 'reports' && controller.class.name.start_with?('Admin::') && action_name == 'daily_collection' ? 'bg-gray-100 font-medium' : ''}",
          onclick: "document.getElementById('mobile-sidebar-overlay').classList.add('hidden')" do %>
          💰 <span>Daily Collection</span>
        <% end %>

        <%= link_to admin_subadmins_path,
          class: "flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-gray-100 transition #{controller_name == 'subadmins' && controller.class.name.start_with?('Admin::') ? 'bg-gray-100 font-medium' : ''}",
          onclick: "document.getElementById('mobile-sidebar-overlay').classList.add('hidden')" do %>
          🛡️ <span>Subadmins</span>
        <% end %>

        <%= link_to admin_settings_path,
          class: "flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-gray-100 transition #{controller_name == 'settings' && controller.class.name.start_with?('Admin::') ? 'bg-gray-100 font-medium' : ''}",
          onclick: "document.getElementById('mobile-sidebar-overlay').classList.add('hidden')" do %>
          ⚙️ <span>Settings</span>
        <% end %>

        <hr class="my-4 border-gray-200">

        <% logout_path = current_user&.admin? ? admin_logout_path : subadmin_logout_path %>
        <%= button_to logout_path, method: :delete,
          class: "w-full flex items-center gap-3 px-3 py-3 rounded-lg text-red-600 hover:bg-red-50 transition text-left bg-transparent border-0 cursor-pointer" do %>
