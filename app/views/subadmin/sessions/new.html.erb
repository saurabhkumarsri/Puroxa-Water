<div class="min-h-screen flex items-center justify-center bg-gray-100">
  <div class="bg-white p-8 rounded-xl shadow-lg w-full max-w-md">
    <div class="text-center mb-6">
      <h1 class="text-2xl font-bold text-[#0d2c63]">Subadmin Login</h1>
      <p class="text-gray-500 mt-1">Puroxa Water Subadmin Portal</p>
    </div>

    <%= form_with url: subadmin_login_path, method: :post, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :user_email, name: "user[email]", class: "w-full border rounded-lg px-3 py-2", required: true %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :user_password, name: "user[password]", class: "w-full border rounded-lg px-3 py-2", required: true %>
      </div>

      <%= f.submit "Sign In",
        class: "w-full bg-[#0d2c63] text-white py-2 rounded-lg hover:scale-105 transition cursor-pointer" %>
    <% end %>

    <div class="mt-4 text-center text-sm">
      <%= link_to "← Back to Website", root_path, class: "text-gray-500 hover:text-[#0d2c63]" %>
    </div>
  </div>
</div>
