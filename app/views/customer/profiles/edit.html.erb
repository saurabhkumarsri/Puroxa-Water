<% content_for :title, "Edit Profile" %>

<div class="max-w-2xl mx-auto">
  <!-- Header -->
  <div class="mb-6 md:mb-8">
    <h1 class="text-xl md:text-2xl font-bold text-gray-800 flex items-center gap-2">
      <span class="w-1 h-6 bg-[#0d2c63] rounded-full"></span>
      Edit Profile ✏️
    </h1>
  </div>

  <%= form_with model: @user, url: customer_profile_path, method: :patch, class: "bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden" do |f| %>
    <div class="p-5 md:p-8 space-y-5">
      <div>
        <%= f.label :shop_name, "Shop / Business Name", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.text_field :shop_name,
          class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#0d2c63]/20 focus:border-[#0d2c63] outline-none transition" %>
      </div>

      <div>
        <%= f.label :first_name, "Owner Name", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.text_field :first_name,
          class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#0d2c63]/20 focus:border-[#0d2c63] outline-none transition" %>
      </div>

      <div>
        <%= f.label :area, "Area / Route", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.text_field :area,
          class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#0d2c63]/20 focus:border-[#0d2c63] outline-none transition",
          placeholder: "e.g. Main Market" %>
      </div>

      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.email_field :email,
          class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#0d2c63]/20 focus:border-[#0d2c63] outline-none transition" %>
      </div>

      <div>
        <%= f.label :contact, "Phone Number", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.text_field :contact,
          class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#0d2c63]/20 focus:border-[#0d2c63] outline-none transition" %>
      </div>

      <div>
        <%= f.label :gst_number, "GST Number (Optional)", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.text_field :gst_number,
          class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#0d2c63]/20 focus:border-[#0d2c63] outline-none transition" %>
      </div>
    </div>

    <div class="px-5 md:px-8 py-5 border-t border-gray-100 bg-gray-50/50 flex flex-col sm:flex-row gap-3">
      <%= f.submit "Save Changes",
        class: "bg-[#0d2c63] text-white px-6 py-2.5 rounded-xl hover:shadow-lg hover:-translate-y-0.5 transition cursor-pointer text-sm font-semibold" %
      <%= link_to "Cancel", customer_profile_path,
        class: "px-6 py-2.5 border border-gray-300 rounded-xl hover:bg-gray-100 text-center text-sm font-medium text-gray-700 transition" %
    </div>
  <% end %
</div>
