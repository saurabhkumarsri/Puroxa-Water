<% content_for(:title) { "Vendor signup — Puroxa Water" } %>

<div class="min-h-screen flex flex-col md:flex-row">
  <%# Left: Branding panel %>
  <%= render "shared/auth_branding", accent: "cyan", variant: :signup %>

  <%# Right: Form panel %>
  <div class="flex-1 flex items-center justify-center px-5 py-10 md:py-12 bg-gradient-to-br from-cyan-50/40 via-white to-sky-50">
    <div class="w-full max-w-lg">

      <div class="text-center md:text-left mb-7">
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight">Become a Puroxa vendor</h2>
        <p class="text-sm text-gray-500 mt-1.5">Tell us about your shop — we'll review and get back within 24 hours.</p>
      </div>

      <%= form_with model: @form, url: vendor_signup_path, scope: :vendor_signup_form, local: true, html: { class: "space-y-4" } do |f| %>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <%= render "shared/auth_field",
                form: f,
                name: :shop_name,
                type: :text,
                label: "Shop name",
                placeholder: "Sharma Kirana Store",
                required: true,
                icon: "M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z M9 22V12h6v10" %>

          <%= render "shared/auth_field",
                form: f,
                name: :name,
                type: :text,
                label: "Owner name",
                placeholder: "Your full name",
                required: true,
                icon: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" %>
        </div>

        <%= render "shared/auth_field",
              form: f,
              name: :email,
              type: :email,
              label: "Email",
              placeholder: "shop@example.com",
              autocomplete: "email",
              required: true,
              icon: "M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" %>

        <%= render "shared/auth_field",
              form: f,
              name: :contact_number,
              type: :tel,
              label: "Mobile number",
              placeholder: "9876543210",
              autocomplete: "tel",
              required: true,
              icon: "M3 5a2 2 0 012-2h2.28a2 2 0 011.94 1.515l.7 2.81a2 2 0 01-.45 1.95L8.09 10.91a16 16 0 006 6l1.64-1.39a2 2 0 011.95-.45l2.81.7A2 2 0 0121 17.72V20a2 2 0 01-2 2A18 18 0 013 5z" %>

        <%= render "shared/auth_field",
              form: f,
              name: :password,
              type: :password,
              label: "Password",
              placeholder: "At least 6 characters",
              autocomplete: "new-password",
              required: true,
              icon: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" %>

        <%= render "shared/auth_field",
              form: f,
              name: :address,
              type: :textarea,
              label: "Shop address",
              placeholder: "Building / street / area / city",
              required: true,
              rows: 2,
              icon: "M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z" %>

        <div class="bg-cyan-50/60 border border-cyan-200 rounded-xl p-3 text-xs text-cyan-900 flex items-start gap-2">
          <svg class="w-4 h-4 mt-0.5 shrink-0 text-cyan-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>After signup, an admin will review and approve your account. You'll be able to sign in once approved.</span>
        </div>

        <%= f.submit "Submit application",
              class: "w-full mt-2 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-sky-500 text-white font-semibold shadow-lg shadow-cyan-200 hover:shadow-xl hover:from-cyan-600 hover:to-sky-600 hover:-translate-y-0.5 transition cursor-pointer" %>
      <% end %>

      <p class="text-center text-sm text-gray-600 mt-6">
        Already a vendor?
        <%= link_to "Sign in", vendor_login_path,
              class: "text-cyan-700 hover:text-cyan-800 font-semibold ml-1" %>
      </p>
    </div>
  </div>
</div>
