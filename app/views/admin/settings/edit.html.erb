<% content_for :title, "Settings" %>

<div class="max-w-2xl mx-auto">
  <!-- Header -->
  <div class="mb-6 md:mb-8">
    <h1 class="text-xl md:text-2xl font-bold text-gray-800 flex items-center gap-2">
      <span class="w-1 h-6 bg-[#0d2c63] rounded-full"></span>
      Business Settings
    </h1>
    <p class="text-gray-500 text-sm mt-1">Configure global business rules and discounts</p>
  </div>

  <!-- Online Payment Discount Card -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/50">
      <h2 class="font-semibold text-gray-800 flex items-center gap-2">
        <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Online Payment Discount
      </h2>
    </div>

    <div class="p-5 md:p-6">
      <p class="text-sm text-gray-500 mb-4">
        When a customer chooses <strong>"Online"</strong> payment mode during order creation, this discount will be auto-applied to their order total.
      </p>

      <%= form_with url: admin_settings_path, method: :patch, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :online_payment_discount_percent, "Discount Percentage", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <div class="flex items-center gap-3">
            <%= f.number_field :online_payment_discount_percent,
              value: @online_discount,
              min: 0,
              max: 50,
              class: "w-24 border border-gray-300 rounded-lg px-3 py-2 text-center font-bold text-[#0d2c63] focus:outline-none focus:ring-2 focus:ring-[#0d2c63]"
            %>
            <span class="text-gray-500 font-medium">%</span>
          </div>
          <p class="text-xs text-gray-400 mt-1">Set 0 to disable online payment discount.</p>
        </div>

        <div class="bg-blue-50 rounded-lg p-3 border border-blue-100">
          <p class="text-xs text-blue-700">
            <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Example: If set to <strong>5%</strong> and a customer orders ₹1000 worth of water with "Online" payment mode, their final total will be ₹950.
          </p>
        </div>

        <div class="pt-2">
          <%= f.submit "Save Settings",
            class: "px-6 py-2.5 bg-[#0d2c63] text-white font-semibold rounded-xl hover:shadow-lg hover:-translate-y-0.5 transition cursor-pointer text-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Quick Stats -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/50">
      <h2 class="font-semibold text-gray-800">Current Active Settings</h2>
    </div>
    <div class="p-5 md:p-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-xs text-gray-400">Online Payment Discount</p>
            <p class="font-bold text-gray-800"><%= @online_discount > 0 ? "#{@online_discount}%" : "Disabled" %></p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-xs text-gray-400">Merchant Name</p>
            <p class="font-bold text-gray-800"><%= MERCHANT_NAME %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
