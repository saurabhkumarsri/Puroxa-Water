<% content_for :title, "Place Order" %>

<div class="max-w-4xl mx-auto">
  <!-- Header -->
  <div class="flex items-center gap-3 mb-6">
    <%= link_to customer_products_path, class: "flex items-center gap-1 text-gray-500 hover:text-[#0d2c63] text-sm font-medium transition" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back
    <% end %>
    <h1 class="text-xl md:text-2xl font-bold text-gray-800">Place Order 🛒</h1>
  </div>

  <%= form_with url: customer_orders_path, method: :post, class: "space-y-6" do |f| %>
    <!-- PRODUCTS -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/50">
        <h2 class="font-semibold text-gray-800 flex items-center gap-2">
          <span class="text-lg">🧴</span> Select Products
        </h2>
      </div>

      <% if @products.any? %>
        <div class="divide-y divide-gray-100">
          <% @products.each_with_index do |product, idx| %>
            <div class="px-5 py-4 flex flex-col sm:flex-row items-start sm:items-center gap-4 hover:bg-gray-50/30 transition" data-product-id="<%= product.id %>">
              <div class="w-14 h-14 bg-blue-50 rounded-xl flex items-center justify-center text-2xl shrink-0">
                🧴
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-gray-800"><%= product.name %></p>
                <p class="text-xs text-gray-400 mt-0.5"><%= product.pack_display %> · ₹<%= product.price %>/pack</p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <button type="button"
                  class="qty-decrease w-9 h-9 bg-gray-100 rounded-full flex items-center justify-center text-gray-700 hover:bg-gray-200 transition font-bold text-sm"
                  data-max="<%= product.stock_quantity %>">-</button>
                <%= f.number_field "order_items[][quantity]",
                  value: 0, min: 0, max: product.stock_quantity,
                  class: "qty-input w-12 border-0 text-center font-bold text-gray-800 bg-transparent",
                  readonly: true %>
                <button type="button"
                  class="qty-increase w-9 h-9 bg-[#0d2c63] text-white rounded-full flex items-center justify-center hover:bg-blue-800 transition font-bold text-sm"
                  data-max="<%= product.stock_quantity %>">+</button>
                <%= f.hidden_field "order_items[][product_id]", value: product.id %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="px-5 py-8 text-center">
          <p class="text-gray-500">No products available.</p>
        </div>
      <% end %>
    </div>

    <!-- DISCOUNT CODE -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/50">
        <h2 class="font-semibold text-gray-800 flex items-center gap-2">
          <span class="text-lg">🏷️</span> Discount Code
        </h2>
      </div>
      <div class="p-5">
        <%= f.text_field :discount_code,
          class: "w-full sm:w-72 border border-gray-200 rounded-xl px-4 py-2.5 text-sm uppercase tracking-wide focus:ring-2 focus:ring-[#0d2c63]/20 focus:border-[#0d2c63] outline-none transition",
          placeholder: "e.g. PUROXA20" %>
        <p class="text-xs text-gray-400 mt-2">Enter a valid coupon code to get discount on your order.</p>
      </div>
    </div>

    <!-- ADDRESS -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/50">
        <h2 class="font-semibold text-gray-800 flex items-center gap-2">
          <span class="text-lg">📍</span> Delivery Address
        </h2>
      </div>
      <div class="p-5">
        <% if @addresses.any? %>
          <div class="space-y-2 mb-4">
            <% @addresses.each do |addr| %>
              <label class="flex items-start gap-3 border border-gray-200 rounded-xl p-4 cursor-pointer hover:bg-blue-50/50 hover:border-blue-200 transition group">
                <%= f.radio_button :delivery_address, addr.full_address,
                  checked: addr.is_default?,
                  class: "mt-1 flex-shrink-0 accent-[#0d2c63]" %>
                <div class="min-w-0">
                  <p class="font-semibold text-sm text-gray-800">
                    <%= addr.label %>
                    <% if addr.is_default? %>
                      <span class="ml-2 text-xs bg-emerald-50 text-emerald-600 px-2 py-0.5 rounded-full font-medium">Default</span>
                    <% end %>
                  </p>
                  <p class="text-sm text-gray-500 mt-0.5 break-words"><%= addr.full_address %></p>
                </div>
              </label>
            <% end %>
          </div>
        <% end %>

        <%= f.text_area :delivery_address, rows: 3,
          class: "w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#0d2c63]/20 focus:border-[#0d2c63] outline-none transition",
          placeholder: "Or enter a new delivery address..." %>
      </div>
    </div>

    <!-- PAYMENT MODE -->
    <% online_discount = AppSetting.get_int('online_payment_discount_percent', 0) %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/50">
        <h2 class="font-semibold text-gray-800 flex items-center gap-2">
          <span class="text-lg">💳</span> Payment Mode
        </h2>
      </div>
      <div class="p-5">
        <div class="flex flex-col sm:flex-row gap-3">
          <label class="flex items-center gap-3 border border-gray-200 rounded-xl p-4 cursor-pointer hover:bg-blue-50/50 hover:border-blue-200 transition flex-1">
            <%= f.radio_button :payment_mode, "cash", checked: true, class: "accent-[#0d2c63]" %>
            <div>
              <p class="font-semibold text-sm text-gray-800">💵 Cash on Delivery</p>
              <p class="text-xs text-gray-500">Pay when vendor delivers</p>
            </div>
          </label>
          <label class="flex items-center gap-3 border-2 border-emerald-200 rounded-xl p-4 cursor-pointer hover:bg-emerald-50/50 hover:border-emerald-300 transition flex-1 relative overflow-hidden">
            <% if online_discount > 0 %>
              <div class="absolute top-0 right-0 bg-emerald-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-bl-lg">SAVE <%= online_discount %>%</div>
            <% end %>
            <%= f.radio_button :payment_mode, "online", class: "accent-[#0d2c63]" %>
            <div>
              <p class="font-semibold text-sm text-gray-800">💳 Online Payment</p>
              <p class="text-xs text-gray-500">Pay via Google Pay / PhonePe / Paytm</p>
              <% if online_discount > 0 %>
                <p class="text-xs text-emerald-600 font-semibold mt-0.5">✅ Get <%= online_discount %>% off instantly!</p>
              <% end %>
            </div>
          </label>
        </div>
      </div>
    </div>

    <!-- NOTES -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/50">
        <h2 class="font-semibold text-gray-800 flex items-center gap-2">
          <span class="text-lg">📝</span> Additional Notes
        </h2>
      </div>
      <div class="p-5">
        <%= f.text_area :notes, rows: 2,
          class: "w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#0d2c63]/20 focus:border-[#0d2c63] outline-none transition",
          placeholder: "Any special instructions for the delivery..." %>
      </div>
    </div>

    <%= f.submit "Place Order",
      class: "w-full bg-[#0d2c63] text-white py-3.5 rounded-xl hover:shadow-lg hover:-translate-y-0.5 transition text-base font-bold cursor-pointer" %>
  <% end %>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.qty-decrease').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var input = this.parentElement.querySelector('.qty-input');
          var val = parseInt(input.value) || 0;
          if (val > 0) {
            input.value = val - 1;
          }
        });
      });
      document.querySelectorAll('.qty-increase').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var input = this.parentElement.querySelector('.qty-input');
          var max = parseInt(this.dataset.max) || 999;
          var val = parseInt(input.value) || 0;
          if (val < max) {
            input.value = val + 1;
          }
        });
      });
    });
  </script>
</div>
