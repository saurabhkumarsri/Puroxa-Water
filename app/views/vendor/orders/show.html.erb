<% content_for :title, "Order ##{@order.id}" %>

<div class="max-w-4xl mx-auto">
  <div class="flex items-center gap-4 mb-6">
    <%= link_to "← Back", vendor_orders_path, class: "text-[#0d2c63] hover:underline" %>
    <h1 class="text-xl md:text-2xl font-bold">Order #<%= @order.id %></h1>
  </div>

  <div class="flex flex-col sm:flex-row justify-end mb-4 gap-2">
    <%= link_to "📄 Download Invoice", vendor_invoice_path(@order),
      class: "inline-block text-sm bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition text-center" %>
  </div>

  <!-- ORDER INFO -->
  <div class="bg-white rounded-xl shadow p-4 md:p-6 mb-6">
    <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-4 mb-6">
      <div>
        <p class="text-sm text-gray-500">Status</p>
        <span class="px-3 py-1 rounded-full text-sm font-medium <%= @order.status_badge_class %>">
          <%= @order.status.titleize %>
        </span>
      </div>
      <div>
        <p class="text-sm text-gray-500">Payment</p>
        <span class="px-3 py-1 rounded-full text-sm font-medium <%= @order.payment_badge_class %>">
          <%= @order.payment_status.titleize %>
        </span>
      </div>
      <div>
        <p class="text-sm text-gray-500">Mode</p>
        <p class="font-medium text-sm uppercase"><%= @order.payment_mode %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Total</p>
        <p class="font-bold text-lg">₹<%= @order.total_amount %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Customer</p>
        <p class="font-medium"><%= @order.customer.display_name %></p>
      </div>
    </div>

    <h2 class="font-semibold mb-3">Items</h2>

    <!-- Desktop Table -->
    <div class="hidden md:block border rounded-lg overflow-hidden mb-6">
      <table class="w-full text-left">
        <thead class="bg-gray-50">
          <tr>
            <th class="py-2 px-4">Product</th>
            <th>Qty</th>
            <th>Price</th>
            <th class="text-right">Total</th>
          </tr>
        </thead>
        <tbody>
          <% @order.order_items.each do |item| %>
            <tr class="border-t">
              <td class="py-2 px-4">
                <%= item.product.name %>
                <span class="text-xs text-gray-500">(<%= item.product.bottles_per_pack %> bottles/pack)</span>
              </td>
              <td><%= item.quantity %> packs</td>
              <td>₹<%= item.unit_price %></td>
              <td class="text-right px-4">₹<%= item.total_price %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Mobile Cards -->
    <div class="md:hidden space-y-3 mb-6">
      <% @order.order_items.each do |item| %>
        <div class="border border-gray-100 rounded-xl p-3 bg-gray-50">
          <p class="font-medium text-sm"><%= item.product.name %></p>
          <p class="text-xs text-gray-500 mb-2">(<%= item.product.bottles_per_pack %> bottles/pack)</p>
          <div class="flex justify-between text-sm">
            <span class="text-gray-500"><%= item.quantity %> packs x ₹<%= item.unit_price %></span>
            <span class="font-bold">₹<%= item.total_price %></span>
          </div>
        </div>
      <% end %>
    </div>

    <% if @order.discount.present? %>
      <div class="flex justify-between text-sm border-t pt-3">
        <span class="text-gray-500">Subtotal</span>
        <span>₹<%= @order.order_items.sum(:total_price) %></span>
      </div>
      <div class="flex justify-between text-sm text-green-600 py-1">
        <span>Discount (<%= @order.discount.code %> — <%= @order.discount.display_value %>)</span>
        <span>-₹<%= @order.discounted_amount %></span>
      </div>
    <% end %>
    <div class="flex justify-between font-bold text-lg border-t pt-4">
      <span>Grand Total</span>
      <span>₹<%= @order.total_amount %></span>
    </div>
  </div>

  <% if @order.delivery_address.present? %>
    <div class="bg-white rounded-xl shadow p-4 md:p-6 mb-6">
      <h2 class="font-semibold mb-2">Delivery Address</h2>
      <p class="text-gray-600"><%= @order.delivery_address %></p>
    </div>
  <% end %>

  <!-- COLLECT CASH / PAYMENT -->
  <% if @order.payment_pending? %>
    <div class="bg-white rounded-xl shadow p-4 md:p-6 mb-6">
      <h2 class="font-semibold mb-4">💰 Collect Payment</h2>
      <div class="flex flex-col sm:flex-row gap-3">
        <% if @order.payment_mode == "cash" %>
          <%= button_to "Collect Cash (₹#{@order.total_amount})", collect_cash_vendor_order_path(@order), method: :patch,
            data: { turbo_confirm: "Confirm cash collection of ₹#{@order.total_amount} from #{@order.customer.display_name}?" },
            class: "flex-1 text-sm bg-green-600 text-white px-5 py-3 rounded-xl hover:bg-green-700 transition font-medium" %>
        <% elsif @order.payment_mode == "online" %>
          <%= button_to "Mark as Online Paid", collect_cash_vendor_order_path(@order), method: :patch,
            data: { turbo_confirm: "Confirm online payment of ₹#{@order.total_amount} received?" },
            class: "flex-1 text-sm bg-blue-600 text-white px-5 py-3 rounded-xl hover:bg-blue-700 transition font-medium" %>
        <% else %>
          <%= button_to "Collect Cash (₹#{@order.total_amount})", collect_cash_vendor_order_path(@order), method: :patch,
            data: { turbo_confirm: "Confirm cash collection of ₹#{@order.total_amount} from #{@order.customer.display_name}?" },
            class: "flex-1 text-sm bg-green-600 text-white px-5 py-3 rounded-xl hover:bg-green-700 transition font-medium" %>
        <% end %>
      </div>
      <p class="text-xs text-gray-500 mt-3">Payment mode: <span class="font-medium uppercase"><%= @order.payment_mode %></span>. Click the button above to confirm collection.</p>
    </div>
  <% else %>
    <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 md:p-6 mb-6">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center text-emerald-600 text-lg">✅</div>
        <div>
          <p class="font-semibold text-emerald-800">Payment Received</p>
          <p class="text-sm text-emerald-600">₹<%= @order.total_amount %> collected via <span class="font-medium uppercase"><%= @order.payment_mode %></span> on <%= @order.updated_at.strftime("%d %b %Y") %>.</p>
        </div>
      </div>
    </div>
  <% end %>

  <!-- VENDOR STATUS UPDATE -->
  <div class="bg-white rounded-xl shadow p-4 md:p-6 mb-6">
    <h2 class="font-semibold mb-4">Update Order Status</h2>
    <div class="flex flex-wrap gap-2">
      <% allowed = %w[confirmed processing shipped delivered] %>
      <% allowed.each do |status| %>
        <%= button_to status.titleize, update_status_vendor_order_path(@order, status: status),
          method: :patch,
          class: "px-4 py-2 rounded border hover:bg-gray-100 #{'bg-[#0d2c63] text-white hover:bg-[#0d2c63]' if @order.status == status}" %>
      <% end %>
    </div>
  </div>

  <!-- CUSTOMER ACTIVITY -->
  <div class="bg-white rounded-xl shadow p-4 md:p-6">
    <h2 class="font-semibold mb-4">👤 Customer Activity — <%= @order.customer.display_name %></h2>
    <div class="flex items-center gap-4 mb-4">
      <div class="w-12 h-12 rounded-full bg-[#0d2c63] text-white flex items-center justify-center text-xl font-bold">
        <%= @order.customer.display_name.first.upcase %>
      </div>
      <div>
        <p class="font-medium"><%= @order.customer.display_name %></p>
        <p class="text-sm text-gray-500"><%= @order.customer.email %> · <%= @order.customer.contact.presence || "—" %></p>
      </div>
    </div>

    <% if @customer_orders.any? %>
      <p class="text-sm text-gray-500 mb-3">Other orders from this customer:</p>
      <!-- Desktop Table -->
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left">
          <thead class="bg-gray-50">
            <tr>
              <th class="py-2 px-4">Order #</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Payment</th>
              <th>Mode</th>
              <th>Date</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @customer_orders.each do |order| %>
              <tr class="border-t hover:bg-gray-50">
                <td class="py-2 px-4 font-medium">#<%= order.id %></td>
                <td>₹<%= order.total_amount %></td>
                <td>
                  <span class="px-2 py-1 rounded-full text-xs font-medium <%= order.status_badge_class %>"><%= order.status.titleize %></span>
                </td>
                <td>
                  <span class="px-2 py-1 rounded-full text-xs font-medium <%= order.payment_badge_class %>"><%= order.payment_status.titleize %></span>
                </td>
                <td class="text-xs text-gray-500 uppercase"><%= order.payment_mode %></td>
                <td class="text-sm text-gray-500"><%= order.created_at.strftime("%d %b %Y") %></td>
                <td class="text-right px-4">
                  <%= link_to "View", vendor_order_path(order), class: "text-[#0d2c63] hover:underline text-sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Mobile Cards -->
      <div class="md:hidden space-y-3">
        <% @customer_orders.each do |order| %>
          <div class="border border-gray-100 rounded-xl p-3 bg-gray-50">
            <div class="flex justify-between items-center mb-2">
              <span class="font-medium text-sm">#<%= order.id %></span>
              <span class="px-2 py-1 rounded-full text-xs font-medium <%= order.status_badge_class %>"><%= order.status.titleize %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">₹<%= order.total_amount %></span>
              <span class="px-2 py-0.5 rounded-full text-xs font-medium <%= order.payment_badge_class %>"><%= order.payment_status.titleize %></span>
            </div>
            <p class="text-xs text-gray-400 mt-1"><%= order.payment_mode&.upcase %> · <%= order.created_at.strftime("%d %b %Y") %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-sm">No other orders from this customer.</p>
    <% end %>
  </div>
</div>
