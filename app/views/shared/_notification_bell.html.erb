<%#
  Reusable notification bell with dropdown.
  Locals:
    namespace  - :vendor or :admin (selects route helpers)
    variant    - :light (white text on dark bg, for mobile dark headers)
                 or :dark (default, for white topbars)
    bell_data  - optional override; defaults to notification_bell_data
%>
<% ns      = (local_assigns[:namespace] || :vendor).to_sym %>
<% variant = (local_assigns[:variant]  || :dark).to_sym %>
<% data    = local_assigns[:bell_data] || notification_bell_data %>
<% unread  = data[:unread] %>
<% recent  = data[:recent] %>

<%
  case ns
  when :vendor
    index_path     = vendor_notifications_path
    mark_all_path  = vendor_mark_all_notifications_read_path
    order_path_for = ->(order) { vendor_order_path(order) }
  when :admin
    index_path     = admin_notifications_path
    mark_all_path  = admin_mark_all_notifications_read_path
    order_path_for = ->(order) { admin_order_path(order) }
  when :customer
    index_path     = customer_notifications_path
    mark_all_path  = customer_mark_all_notifications_read_path
    order_path_for = ->(order) { customer_order_path(order) }
  else
    raise "Unsupported bell namespace: #{ns.inspect}"
  end

  if variant == :light
    btn_classes   = "relative text-white/90 hover:text-white p-2 rounded-lg hover:bg-white/10 transition"
    ring_color    = "ring-[#0d2c63]"
  else
    btn_classes   = "relative text-gray-600 hover:text-[#0d2c63] p-2 rounded-lg hover:bg-gray-100 transition"
    ring_color    = "ring-white"
  end

  # Unique DOM id for this bell instance
  dom_id = "notification-bell-#{ns}-#{object_id}"
%>

<div class="relative">
  <button type="button"
          id="<%= dom_id %>-button"
          onclick="var p=document.getElementById('<%= dom_id %>-panel'); p.classList.toggle('hidden');"
          aria-label="Notifications"
          class="<%= btn_classes %>">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round"
            d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0a3 3 0 11-6 0m6 0H9"/>
    </svg>
    <% if unread > 0 %>
      <span class="absolute top-0.5 right-0.5 min-w-[18px] h-[18px] px-1 bg-red-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center ring-2 <%= ring_color %>">
        <%= unread > 99 ? "99+" : unread %>
      </span>
    <% end %>
  </button>

  <div id="<%= dom_id %>-panel"
       class="hidden absolute right-0 mt-2 w-[320px] max-w-[90vw] bg-white text-gray-800 rounded-2xl shadow-xl border border-gray-200 overflow-hidden z-50">
    <%# Header %>
    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
      <p class="font-semibold text-sm text-gray-800">🔔 Notifications</p>
      <% if unread > 0 %>
        <%= button_to mark_all_path, method: :patch,
              data: { turbo_confirm: "Mark all notifications as read?" },
              class: "text-xs text-[#0d2c63] hover:text-cyan-600 font-medium bg-transparent border-0 cursor-pointer" do %>
          Mark all read
        <% end %>
      <% end %>
    </div>

    <%# List %>
    <% if recent.any? %>
      <ul class="max-h-[360px] overflow-y-auto divide-y divide-gray-100">
        <% recent.each do |n| %>
          <% target = n.order.present? ? order_path_for.call(n.order) : nil %>
          <li class="<%= n.read? ? 'bg-white' : 'bg-blue-50/40' %>">
            <% inner = capture do %>
              <div class="flex items-start gap-3">
                <div class="mt-1.5 shrink-0">
                  <% if n.read? %>
                    <div class="w-2 h-2 rounded-full bg-gray-300"></div>
                  <% else %>
                    <div class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></div>
                  <% end %>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="font-semibold text-sm text-gray-800 truncate"><%= n.title %></p>
                  <% if n.body.present? %>
                    <p class="text-xs text-gray-500 line-clamp-2 break-words"><%= n.body %></p>
                  <% end %>
                  <p class="text-[10px] text-gray-400 mt-1"><%= time_ago_in_words(n.created_at) %> ago</p>
                </div>
              </div>
            <% end %>
            <% if target %>
              <%= link_to target, class: "block px-4 py-3 hover:bg-gray-50 transition" do %>
                <%= inner %>
              <% end %>
            <% else %>
              <div class="px-4 py-3"><%= inner %></div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="px-4 py-10 text-center">
        <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-2 text-2xl">🔔</div>
        <p class="text-sm text-gray-500">No notifications yet</p>
        <p class="text-xs text-gray-400 mt-1">You'll be notified when something new arrives.</p>
      </div>
    <% end %>

    <%# Footer %>
    <div class="px-4 py-2 border-t border-gray-100 bg-gray-50/60 text-center">
      <%= link_to "View all notifications", index_path,
            class: "text-xs font-medium text-[#0d2c63] hover:text-cyan-600" %>
    </div>
  </div>
</div>
