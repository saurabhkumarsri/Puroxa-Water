<%#
  Reusable left-side branding panel for split-screen auth layouts.

  Locals:
    accent  - "blue" (default) | "cyan" | "slate" — picks the color theme
    variant - :login (default) | :signup — changes the headline

  Renders a self-contained div meant to be placed inside a 2-column grid.
  Mobile-first: collapses to top banner via the parent's grid-cols-1 / md:grid-cols-2.
%>
<%
  accent  = (local_assigns[:accent]  || "blue").to_s
  variant = (local_assigns[:variant] || :login).to_sym

  theme = case accent
          when "cyan"
            { ring: "ring-cyan-300", text: "text-cyan-100", text_strong: "text-white", muted: "text-cyan-200/80", blob: "bg-cyan-400/30", blob2: "bg-cyan-300/20", chip: "bg-cyan-500/20 text-cyan-100", btn: "bg-cyan-500 hover:bg-cyan-400 focus:ring-cyan-300" }
          when "slate"
            { ring: "ring-indigo-300", text: "text-indigo-100", text_strong: "text-white", muted: "text-indigo-200/80", blob: "bg-indigo-400/30", blob2: "bg-violet-400/20", chip: "bg-indigo-500/20 text-indigo-100", btn: "bg-indigo-500 hover:bg-indigo-400 focus:ring-indigo-300" }
          else
            { ring: "ring-sky-300", text: "text-sky-100", text_strong: "text-white", muted: "text-sky-200/80", blob: "bg-sky-400/30", blob2: "bg-cyan-400/20", chip: "bg-sky-500/20 text-sky-100", btn: "bg-sky-500 hover:bg-sky-400 focus:ring-sky-300" }
          end

  headline = case variant
             when :signup then "Start your<br/>water journey."
             when :forgot then "Reset & get<br/>back to flow."
             else "Pure water,<br/>delivered."
             end

  sub = case variant
        when :signup then "Place orders, track deliveries, manage your account — all in one place."
        when :forgot then "We'll email you a secure link to choose a new password."
        else "Sign in to order fresh water, track deliveries, and manage your account."
        end
%>

<div class="relative <%= accent == 'slate' ? 'bg-gradient-to-br from-[#0d2c63] via-indigo-700 to-violet-700' : (accent == 'cyan' ? 'bg-gradient-to-br from-cyan-600 via-cyan-500 to-sky-500' : 'bg-gradient-to-br from-[#0d2c63] via-sky-700 to-cyan-600') %> text-white p-8 md:p-12 flex flex-col justify-between overflow-hidden">

  <!-- Decorative blobs -->
  <div class="absolute -top-20 -left-20 w-72 h-72 <%= theme[:blob] %> rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 -right-16 w-80 h-80 <%= theme[:blob2] %> rounded-full blur-3xl"></div>
  <div class="absolute top-1/3 right-8 w-32 h-32 border border-white/10 rounded-full"></div>
  <div class="absolute bottom-20 left-10 w-20 h-20 border border-white/10 rounded-full"></div>

  <!-- Logo -->
  <div class="relative z-10 flex items-center gap-3">
    <div class="w-11 h-11 bg-white/15 backdrop-blur-sm rounded-xl flex items-center justify-center ring-1 <%= theme[:ring] %>">
      <svg class="w-6 h-6 <%= theme[:text_strong] %>" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2.69l5.66 5.66a8 8 0 11-11.32 0L12 2.69z"/>
      </svg>
    </div>
    <span class="text-xl font-bold tracking-tight">Puroxa</span>
  </div>

  <!-- Headline + illustration -->
  <div class="relative z-10 my-10 md:my-0">
    <h1 class="text-3xl md:text-5xl font-extrabold leading-tight tracking-tight <%= theme[:text_strong] %>">
      <%= headline.html_safe %>
    </h1>
    <p class="mt-4 text-base md:text-lg <%= theme[:muted] %> max-w-sm">
      <%= sub %>
    </p>

    <!-- Water-themed illustration (pure SVG, no external deps) -->
    <div class="mt-8 hidden md:block">
      <svg class="w-48 h-48 opacity-90" viewBox="0 0 200 200" fill="none" aria-hidden="true">
        <!-- Drop -->
        <path d="M100 20 C 70 60, 50 90, 50 120 a50 50 0 0 0 100 0 C 150 90, 130 60, 100 20 Z"
              fill="white" fill-opacity="0.18" stroke="white" stroke-opacity="0.6" stroke-width="1.5"/>
        <!-- Highlight -->
        <ellipse cx="85" cy="100" rx="10" ry="20" fill="white" fill-opacity="0.35"/>
        <!-- Ripple ring 1 -->
        <ellipse cx="100" cy="180" rx="55" ry="6" stroke="white" stroke-opacity="0.4" fill="none" stroke-width="1"/>
        <!-- Ripple ring 2 -->
        <ellipse cx="100" cy="186" rx="35" ry="4" stroke="white" stroke-opacity="0.3" fill="none" stroke-width="1"/>
      </svg>
    </div>
  </div>

  <!-- Footer mini-feature list -->
  <div class="relative z-10 space-y-2 text-sm <%= theme[:text] %>">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-white/80"></span>
      <span>Free delivery on first 3 orders</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-white/80"></span>
      <span>Pay cash or online — both supported</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-white/80"></span>
      <span>Trusted by 500+ shops &amp; homes</span>
    </div>
  </div>
</div>
