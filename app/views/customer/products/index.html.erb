<% content_for :title, "Our Products" %>

<div class="max-w-6xl mx-auto">
  <!-- Header -->
  <div class="mb-6 md:mb-8">
    <h1 class="text-xl md:text-2xl font-bold text-gray-800 flex items-center gap-2">
      <span class="w-1 h-6 bg-[#0d2c63] rounded-full"></span>
      Our Products 🧴
    </h1>
    <p class="text-gray-500 text-sm mt-1">Choose from our range of fresh packaged drinking water</p>
  </div>

  <% if @products.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-6">
      <% @products.each do |product| %>
        <div class="group bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <!-- Image Area -->
          <div class="h-40 md:h-48 bg-gray-50 flex items-center justify-center relative overflow-hidden">
            <% if product.image.present? %>
              <img src="<%= product.image %>" class="h-full object-contain p-4 group-hover:scale-105 transition-transform duration-300" alt="<%= product.name %>">
            <% else %>
              <div class="text-6xl grayscale opacity-60">🧴</div>
            <% end %>
            <% unless product.active? %>
              <div class="absolute top-3 left-3 px-2 py-1 bg-gray-800/80 text-white text-xs font-medium rounded-lg backdrop-blur">
                Out of Stock
              </div>
            <% end %>
          </div>

          <!-- Content -->
          <div class="p-4 md:p-5">
            <h3 class="font-bold text-gray-800 mb-1"><%= product.name %></h3>
            <p class="text-gray-400 text-xs mb-3 line-clamp-2"><%= product.description %></p>

            <div class="flex items-center gap-2 mb-3">
              <span class="inline-flex items-center px-2 py-1 bg-blue-50 text-blue-700 text-xs font-medium rounded-md">
                <%= product.pack_display %>
              </span>
              <span class="inline-flex items-center px-2 py-1 bg-gray-100 text-gray-600 text-xs font-medium rounded-md">
                <%= product.size %>
              </span>
            </div>

            <div class="flex items-center justify-between pt-3 border-t border-gray-100">
              <div>
                <p class="text-xs text-gray-400">Price per pack</p>
                <p class="text-lg font-bold text-[#0d2c63]">₹<%= product.price %></p>
              </div>
              <% if product.active? %>
                <span class="text-xs text-emerald-600 font-medium bg-emerald-50 px-2 py-1 rounded-md">
                  In Stock
                </span>
              <% else %>
                <span class="text-xs text-gray-500 font-medium bg-gray-100 px-2 py-1 rounded-md">
                  Unavailable
                </span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- CTA -->
    <div class="mt-8 md:mt-10 text-center bg-[#0d2c63] rounded-2xl p-6 md:p-10 text-white shadow-lg relative overflow-hidden">
      <div class="absolute top-0 right-0 w-40 h-40 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
      <div class="absolute bottom-0 left-0 w-32 h-32 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2"></div>
      <div class="relative z-10">
        <p class="text-xl md:text-2xl font-bold mb-2">Ready to order?</p>
        <p class="text-blue-200 text-sm mb-5">Get fresh water delivered to your doorstep</p>
        <%= link_to "Place Order Now →", new_customer_order_path,
          class: "inline-block bg-white text-[#0d2c63] px-8 py-3 rounded-xl font-bold hover:shadow-xl hover:-translate-y-0.5 transition" %>
      </div>
    </div>
  <% else %>
    <div class="text-center py-16 bg-white rounded-2xl shadow-sm border border-gray-100">
      <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4 text-4xl">🧴</div>
      <p class="text-gray-500 text-lg">No products available right now.</p>
      <p class="text-gray-400 text-sm mt-1">Please check back later.</p>
    </div>
  <% end %>
</div>
