<% content_for :page_title, "Edit Subadmin" %>

<div class="max-w-xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">Edit Subadmin ✏️</h1>

  <%= form_with model: @subadmin, url: admin_subadmin_path(@subadmin), method: :patch, class: "bg-white rounded-xl shadow p-6 space-y-4" do |f| %>
    <div>
      <%= f.label :first_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :first_name, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div>
      <%= f.label :contact, "Phone", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :contact, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div>
      <%= f.label :password, "New Password (leave blank to keep current)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password_confirmation, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div class="flex gap-3 pt-2">
      <%= f.submit "Update Subadmin",
        class: "bg-[#0d2c63] text-white px-4 py-2 rounded hover:scale-105 transition cursor-pointer" %>
      <%= link_to "Cancel", admin_subadmins_path,
        class: "px-4 py-2 border rounded hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
