<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Puroxa Water" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex flex-col min-h-screen">
    <!-- Navbar -->
    <%= render "layouts/customer_navbar" %>

    <!-- Flash Messages -->
    <% if notice %>
      <div class="bg-green-100 text-green-800 p-4 text-center"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="bg-red-100 text-red-800 p-4 text-center"><%= alert %></div>
    <% end %>

    <!-- Page Content -->
    <main class="flex-grow">
      <%= yield %>
    </main>

    <!-- Footer -->
    <%= render "layouts/customer_footer" %>
  </body>
</html>
