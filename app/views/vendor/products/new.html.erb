<% content_for :title, "New Product" %>

<div class="max-w-xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">Add Product ➕</h1>

  <%= form_with model: [:vendor, @product], class: "bg-white rounded-xl shadow p-6 space-y-4" do |f| %>
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div>
      <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 2, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :size, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :size, Product::SIZES, {}, class: "w-full border rounded-lg px-3 py-2" %>
      </div>
      <div>
        <%= f.label :price, "Price per Pack (₹)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :price, step: 0.01, class: "w-full border rounded-lg px-3 py-2" %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :bottles_per_pack, "Bottles per Pack", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :bottles_per_pack, value: @product.bottles_per_pack || 1, min: 1, class: "w-full border rounded-lg px-3 py-2" %>
      </div>
      <div>
        <%= f.label :stock_quantity, "Stock (Packs)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :stock_quantity, class: "w-full border rounded-lg px-3 py-2" %>
      </div>
    </div>

    <div>
      <%= f.label :image, "Image URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :image, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div class="flex items-center gap-2">
      <%= f.check_box :active %>
      <%= f.label :active, "Active", class: "text-sm" %>
    </div>

    <div class="flex gap-3 pt-2">
      <%= f.submit "Create Product",
        class: "bg-[#0d2c63] text-white px-4 py-2 rounded hover:scale-105 transition cursor-pointer" %>
      <%= link_to "Cancel", vendor_products_path,
        class: "px-4 py-2 border rounded hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
