<% content_for :page_title, "Products" %>

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-3">
  <h1 class="text-xl md:text-2xl font-bold text-gray-800">Products 🧴</h1>
  <%= link_to "+ Add Product", new_admin_product_path,
    class: "bg-[#0d2c63] text-white px-4 py-2 rounded-lg hover:shadow-lg hover:-translate-y-0.5 transition text-sm font-medium shrink-0" %>
</div>

<!-- Desktop Table -->
<div class="hidden md:block bg-white rounded-xl shadow overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead class="bg-gray-50">
        <tr>
          <th class="py-3 px-4">Name</th>
          <th>Size</th>
          <th>Pack</th>
          <th>Price</th>
          <th>Stock</th>
          <th>Status</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr class="border-t hover:bg-gray-50">
            <td class="py-3 px-4 font-medium"><%= product.name %></td>
            <td><%= product.size %></td>
            <td><%= product.bottles_per_pack %> bottles</td>
            <td>₹<%= product.price %></td>
            <td><%= product.stock_quantity %> packs</td>
            <td>
              <% if product.active? %>
                <span class="px-2 py-1 bg-green-100 text-green-800 rounded-full text-xs font-medium">Active</span>
              <% else %>
                <span class="px-2 py-1 bg-gray-100 text-gray-800 rounded-full text-xs font-medium">Inactive</span>
              <% end %>
            </td>
            <td class="text-right px-4">
              <div class="flex gap-2 justify-end">
                <%= link_to "Edit", edit_admin_product_path(product),
                  class: "text-xs bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700" %>
                <%= button_to "Delete", admin_product_path(product),
                  method: :delete,
                  data: { turbo_confirm: "Are you sure?" },
                  class: "text-xs bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<!-- Mobile Cards -->
<div class="md:hidden grid grid-cols-1 sm:grid-cols-2 gap-3">
  <% @products.each do |product| %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
      <div class="flex justify-between items-start mb-2">
        <p class="font-bold text-gray-800"><%= product.name %></p>
        <% if product.active? %>
          <span class="px-2 py-1 bg-green-100 text-green-800 rounded-full text-xs font-medium">Active</span>
        <% else %>
          <span class="px-2 py-1 bg-gray-100 text-gray-800 rounded-full text-xs font-medium">Inactive</span>
        <% end %>
      </div>
      <div class="text-sm text-gray-500 mb-3"><%= product.size %> · <%= product.bottles_per_pack %> bottles/pack</div>
      <div class="flex justify-between items-center mb-3">
        <div>
          <p class="text-xs text-gray-400">Price</p>
          <p class="font-bold text-[#0d2c63]">₹<%= product.price %></p>
        </div>
        <div class="text-right">
          <p class="text-xs text-gray-400">Stock</p>
          <p class="font-semibold"><%= product.stock_quantity %> packs</p>
        </div>
      </div>
      <div class="flex gap-2 pt-3 border-t border-gray-100">
        <%= link_to "Edit", edit_admin_product_path(product),
          class: "flex-1 text-center text-xs bg-blue-600 text-white px-3 py-2 rounded-lg hover:bg-blue-700" %>
        <%= button_to "Delete", admin_product_path(product),
          method: :delete,
          data: { turbo_confirm: "Are you sure?" },
          class: "flex-1 text-xs bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-700 bg-transparent border-0 cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>
