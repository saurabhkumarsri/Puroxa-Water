<% content_for :title, "Install Puroxa Water" %>

<div class="min-h-screen bg-gradient-to-br from-[#0d2c63] via-blue-700 to-cyan-500 flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full overflow-hidden">

    <!-- Header -->
    <div class="bg-gradient-to-r from-[#0d2c63] to-blue-700 text-white px-6 py-6 text-center">
      <div class="flex items-center justify-center gap-3 mb-2">
        <img src="/icons/icon-192.png" alt="Puroxa Water" class="w-12 h-12 rounded-xl shadow-lg">
        <h1 class="text-2xl font-bold">Puroxa Water</h1>
      </div>
      <p class="text-blue-100 text-sm">Install our app — it's free, no Play Store needed</p>
    </div>

    <!-- QR Code -->
    <div class="px-6 py-8 text-center">
      <div class="bg-gray-50 border-2 border-dashed border-gray-200 rounded-2xl p-4 inline-block">
        <img
          src="https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=<%= u @pwa_url %>&color=0d2c63"
          alt="Scan to install Puroxa Water"
          class="w-60 h-60 mx-auto block"
          width="240"
          height="240">
      </div>
      <p class="text-sm text-gray-500 mt-4">
        Scan this QR code with your phone's camera
      </p>
    </div>

    <!-- Steps -->
    <div class="px-6 pb-6 space-y-3">
      <div class="flex items-start gap-3 p-3 bg-blue-50 rounded-xl">
        <div class="shrink-0 w-7 h-7 bg-[#0d2c63] text-white rounded-full flex items-center justify-center text-sm font-bold">1</div>
        <div>
          <p class="font-semibold text-gray-800 text-sm">Open your phone camera</p>
          <p class="text-xs text-gray-500">or any QR scanner app</p>
        </div>
      </div>

      <div class="flex items-start gap-3 p-3 bg-blue-50 rounded-xl">
        <div class="shrink-0 w-7 h-7 bg-[#0d2c63] text-white rounded-full flex items-center justify-center text-sm font-bold">2</div>
        <div>
          <p class="font-semibold text-gray-800 text-sm">Tap the link that appears</p>
          <p class="text-xs text-gray-500">It will open Puroxa Water in your browser</p>
        </div>
      </div>

      <div class="flex items-start gap-3 p-3 bg-blue-50 rounded-xl">
        <div class="shrink-0 w-7 h-7 bg-[#0d2c63] text-white rounded-full flex items-center justify-center text-sm font-bold">3</div>
        <div>
          <p class="font-semibold text-gray-800 text-sm">Add to Home Screen</p>
          <p class="text-xs text-gray-500">
            <strong>iPhone:</strong> Safari → Share (⬆️) → "Add to Home Screen"<br>
            <strong>Android:</strong> Chrome → Menu (⋮) → "Install app"
          </p>
        </div>
      </div>
    </div>

    <!-- Direct Link -->
    <div class="px-6 pb-6">
      <p class="text-xs text-gray-500 text-center mb-2">Or open this link directly:</p>
      <a href="<%= @pwa_url %>"
         class="block w-full text-center bg-gradient-to-r from-[#0d2c63] to-blue-600 text-white py-3 px-4 rounded-xl font-semibold shadow-lg hover:shadow-xl transition">
        <%= @pwa_url.gsub('https://', '') %> →
      </a>
    </div>

    <!-- App Features -->
    <div class="bg-gray-50 px-6 py-4 border-t">
      <div class="grid grid-cols-3 gap-2 text-center">
        <div>
          <div class="text-2xl">⚡</div>
          <p class="text-xs text-gray-600 mt-1">Fast<br>launch</p>
        </div>
        <div>
          <div class="text-2xl">📱</div>
          <p class="text-xs text-gray-600 mt-1">Full<br>screen</p>
        </div>
        <div>
          <div class="text-2xl">🔔</div>
          <p class="text-xs text-gray-600 mt-1">Push<br>alerts</p>
        </div>
      </div>
    </div>

  </div>
</div>
