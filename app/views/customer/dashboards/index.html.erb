<% content_for :title, "My Dashboard" %>

<div class="max-w-6xl mx-auto">
  <!-- Welcome Banner -->
  <div class="bg-[#0d2c63] rounded-2xl p-5 md:p-8 mb-6 md:mb-8 text-white shadow-lg relative overflow-hidden">
    <div class="absolute top-0 right-0 w-32 h-32 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
    <div class="absolute bottom-0 left-0 w-24 h-24 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2"></div>
    <div class="relative z-10 flex items-center gap-4">
      <div class="w-14 h-14 rounded-full bg-white/20 backdrop-blur flex items-center justify-center text-2xl font-bold ring-2 ring-white/30 shrink-0">
        <%= current_user.display_name.first.upcase %>
      </div>
      <div>
        <p class="text-blue-200 text-sm md:text-base">Welcome back, 👋</p>
        <h1 class="text-xl md:text-2xl font-bold"><%= current_user.display_name %></h1>
      </div>
    </div>
  </div>

  <!-- STATS CARDS -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 md:gap-6 mb-6 md:mb-8">
    <div class="bg-white p-4 md:p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-3 md:gap-4 hover:shadow-md transition">
      <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-blue-50 flex items-center justify-center text-xl md:text-2xl shrink-0">📦</div>
      <div>
        <p class="text-gray-500 text-xs md:text-sm font-medium">Total Orders</p>
        <p class="text-xl md:text-3xl font-bold text-[#0d2c63]"><%= @total_orders %></p>
      </div>
    </div>

    <div class="bg-white p-4 md:p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-3 md:gap-4 hover:shadow-md transition">
      <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-amber-50 flex items-center justify-center text-xl md:text-2xl shrink-0">⏳</div>
      <div>
        <p class="text-gray-500 text-xs md:text-sm font-medium">Pending</p>
        <p class="text-xl md:text-3xl font-bold text-amber-500"><%= @pending_orders %></p>
      </div>
    </div>

    <div class="bg-white p-4 md:p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-3 md:gap-4 hover:shadow-md transition">
      <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-emerald-50 flex items-center justify-center text-xl md:text-2xl shrink-0">✅</div>
      <div>
        <p class="text-gray-500 text-xs md:text-sm font-medium">Delivered</p>
        <p class="text-xl md:text-3xl font-bold text-emerald-600"><%= @delivered_orders %></p>
      </div>
    </div>

    <div class="bg-white p-4 md:p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center gap-3 md:gap-4 hover:shadow-md transition">
      <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-red-50 flex items-center justify-center text-xl md:text-2xl shrink-0">💳</div>
      <div>
        <p class="text-gray-500 text-xs md:text-sm font-medium">Pending Payment</p>
        <p class="text-xl md:text-3xl font-bold text-red-500">₹<%= number_with_precision(@pending_amount, precision: 0) %></p>
      </div>
    </div>
  </div>

  <!-- QUICK ACTIONS -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 md:p-6 mb-6">
    <h2 class="text-base md:text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <span class="w-1 h-5 bg-[#0d2c63] rounded-full"></span>
      Quick Actions
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
      <%= link_to customer_products_path, class: "group flex flex-col items-center gap-2 p-4 rounded-xl bg-blue-50 hover:bg-blue-100 transition border border-blue-100 hover:border-blue-200" do %>
        <div class="w-12 h-12 rounded-full bg-white shadow-sm flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">🛒</div>
        <p class="font-semibold text-sm text-[#0d2c63]">Order Water</p>
      <% end %>
      <%= link_to customer_orders_path, class: "group flex flex-col items-center gap-2 p-4 rounded-xl bg-purple-50 hover:bg-purple-100 transition border border-purple-100 hover:border-purple-200" do %>
        <div class="w-12 h-12 rounded-full bg-white shadow-sm flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">📦</div>
        <p class="font-semibold text-sm text-purple-700">My Orders</p>
      <% end %>
      <%= link_to customer_profile_path, class: "group flex flex-col items-center gap-2 p-4 rounded-xl bg-orange-50 hover:bg-orange-100 transition border border-orange-100 hover:border-orange-200" do %>
        <div class="w-12 h-12 rounded-full bg-white shadow-sm flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">👤</div>
        <p class="font-semibold text-sm text-orange-700">Profile</p>
      <% end %>
      <%= link_to customer_addresses_path, class: "group flex flex-col items-center gap-2 p-4 rounded-xl bg-teal-50 hover:bg-teal-100 transition border border-teal-100 hover:border-teal-200" do %>
        <div class="w-12 h-12 rounded-full bg-white shadow-sm flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">📍</div>
        <p class="font-semibold text-sm text-teal-700">Addresses</p>
      <% end %>
    </div>
  </div>

  <!-- MONTHLY SPEND CHART -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 md:p-6 mb-6 md:mb-8">
    <div class="flex justify-between items-center mb-5">
      <h2 class="text-base md:text-lg font-semibold text-gray-800 flex items-center gap-2">
        <span class="w-1 h-5 bg-[#0d2c63] rounded-full"></span>
        Monthly Spend
      </h2>
      <p class="text-gray-500 text-sm">Last 6 months</p>
    </div>

    <% if @monthly_spend.any? { |m| m[:amount] > 0 } %>
      <div class="flex items-end gap-2 md:gap-4 h-40 md:h-48">
        <% max_amount = @monthly_spend.map { |m| m[:amount] }.max.to_f %>
        <% @monthly_spend.each do |month| %>
          <% height = max_amount > 0 ? (month[:amount] / max_amount * 100).round(1) : 0 %>
          <div class="flex-1 flex flex-col items-center gap-2 group">
            <div class="w-full bg-gray-100 rounded-t-lg relative overflow-hidden flex items-end h-32 md:h-40">
              <div class="w-full bg-gradient-to-t from-[#0d2c63] to-blue-400 rounded-t-lg transition-all duration-500 group-hover:from-blue-600 group-hover:to-cyan-400 relative"
                   style="height: <%= [height, 5].max %>%;">
                <% if month[:amount] > 0 %>
                  <div class="absolute -top-6 left-1/2 -translate-x-1/2 bg-[#0d2c63] text-white text-[10px] md:text-xs px-2 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">
                    ₹<%= number_with_precision(month[:amount], precision: 0) %>
                  </div>
                <% end %>
              </div>
            </div>
            <p class="text-[10px] md:text-xs text-gray-500 font-medium"><%= month[:label] %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8 text-gray-400">
        <p class="text-sm">No orders yet. Start ordering to see your spend trend!</p>
      </div>
    <% end %>
  </div>

  <!-- RECENT ORDERS -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 md:p-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-5 gap-3">
      <h2 class="text-base md:text-lg font-semibold text-gray-800 flex items-center gap-2">
        <span class="w-1 h-5 bg-[#0d2c63] rounded-full"></span>
        Recent Orders
      </h2>
      <%= link_to "View All →", customer_orders_path, class: "text-[#0d2c63] hover:text-cyan-600 text-sm font-medium transition" %>
    </div>

    <% if @orders.any? %>
      <!-- Desktop Table -->
      <div class="hidden md:block overflow-x-auto -mx-2 px-2">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-gray-100">
              <th class="py-3 text-xs font-semibold text-gray-400 uppercase tracking-wider">Order #</th>
              <th class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Date</th>
              <th class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Total</th>
              <th class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            <% @orders.each do |order| %>
              <tr class="hover:bg-gray-50/50 transition">
                <td class="py-3.5 font-semibold text-sm text-[#0d2c63]">#<%= order.id %></td>
                <td class="text-sm text-gray-500"><%= order.created_at.strftime("%d %b %Y") %></td>
                <td class="text-sm font-semibold text-gray-800">₹<%= order.total_amount %></td>
                <td>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold <%= order.status_badge_class %>">
                    <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                    <%= order.status.titleize %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Mobile Cards -->
      <div class="md:hidden space-y-3">
        <% @orders.each do |order| %>
          <div class="border border-gray-100 rounded-xl p-3 bg-gray-50">
            <div class="flex justify-between items-center mb-2">
              <span class="font-semibold text-sm text-[#0d2c63]">#<%= order.id %></span>
              <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-full text-xs font-semibold <%= order.status_badge_class %>">
                <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                <%= order.status.titleize %>
              </span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500"><%= order.created_at.strftime("%d %b %Y") %></span>
              <span class="font-semibold text-gray-800">₹<%= order.total_amount %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-10">
        <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3 text-3xl">📦</div>
        <p class="text-gray-500 text-base mb-4">No orders yet!</p>
        <%= link_to "Place Your First Order", customer_products_path,
          class: "bg-[#0d2c63] text-white px-5 py-2.5 rounded-xl hover:shadow-lg hover:-translate-y-0.5 transition inline-block text-sm font-medium" %>
      </div>
    <% end %>
  </div>
</div>
