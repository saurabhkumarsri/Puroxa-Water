<% content_for :title, "My Profile" %>

<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold mb-6">My Profile 👤</h1>

  <div class="bg-white rounded-xl shadow p-6 space-y-4">
    <div>
      <p class="text-sm text-gray-500">Shop Name</p>
      <p class="font-medium"><%= @vendor.shop_name %></p>
    </div>

    <div>
      <p class="text-sm text-gray-500">Email</p>
      <p class="font-medium"><%= @vendor.user.email %></p>
    </div>

    <div>
      <p class="text-sm text-gray-500">Contact Number</p>
      <p class="font-medium"><%= @vendor.contact_number.presence || "—" %></p>
    </div>

    <div>
      <p class="text-sm text-gray-500">Address</p>
      <p class="font-medium"><%= @vendor.address %></p>
    </div>

    <div>
      <p class="text-sm text-gray-500">Approval Status</p>
      <p class="font-medium">
        <% if @vendor.approved? %>
          <span class="text-green-600">✅ Approved</span>
        <% elsif @vendor.approved == false %>
          <span class="text-red-600">❌ Rejected</span>
        <% else %>
          <span class="text-yellow-600">⏳ Pending Approval</span>
        <% end %>
      </p>
    </div>

    <div class="pt-4">
      <%= link_to "Edit Profile", edit_vendor_profile_path,
        class: "bg-[#0d2c63] text-white px-4 py-2 rounded hover:scale-105 transition inline-block" %>
    </div>
  </div>
</div>
