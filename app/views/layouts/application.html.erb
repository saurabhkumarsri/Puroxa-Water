<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Puroxa Water" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <meta property="og:title" content="<%= content_for(:title) || 'Puroxa Water' %>">
    <meta property="og:description" content="Pure water delivery at your doorstep.">
    <meta property="og:image" content="<%= request.base_url %>/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex flex-col min-h-screen">
    <!-- Navbar -->
    <%= render "layouts/customer_navbar" %>

    <% if current_user && current_user.customer? && !(controller_name == "landing" && action_name == "index") %>
      <!-- Logged-in Customer: Sidebar + Content -->
      <div class="flex flex-1">
        <%= render "layouts/customer_sidebar" %>

        <main class="flex-1">
          <!-- Flash Messages -->
          <% if notice %>
            <div class="bg-green-100 text-green-800 p-4 text-center"><%= notice %></div>
          <% end %>
          <% if alert %>
            <div class="bg-red-100 text-red-800 p-4 text-center"><%= alert %></div>
          <% end %>

          <%= yield %>
        </main>
      </div>
    <% else %>
      <!-- Guest: Full-width Content -->
      <!-- Flash Messages -->
      <% if notice %>
        <div class="bg-green-100 text-green-800 p-4 text-center"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="bg-red-100 text-red-800 p-4 text-center"><%= alert %></div>
      <% end %>

      <main class="flex-grow">
        <%= yield %>
      </main>
    <% end %>

    <% unless current_user %>
      <!-- Footer -->
      <%= render "layouts/customer_footer" %>
    <% end %>
  </body>
</html>
<!-- Turbo enabled for SPA navigation -->
