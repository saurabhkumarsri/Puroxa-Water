<% content_for :page_title, "Customer Details" %>

<div class="max-w-5xl mx-auto">
  <!-- Breadcrumb + Title -->
  <div class="flex items-center gap-3 mb-6">
    <%= link_to admin_customers_path, class: "flex items-center gap-1 text-gray-500 hover:text-[#0d2c63] text-sm font-medium transition" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back
    <% end %>
    <h1 class="text-xl md:text-2xl font-bold text-gray-800">Customer Details</h1>
  </div>

  <!-- Profile Card -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-6">
    <div class="h-24 bg-[#0d2c63] relative">
      <div class="absolute bottom-0 left-6 translate-y-1/2">
        <div class="w-20 h-20 rounded-2xl bg-white shadow-lg flex items-center justify-center text-3xl font-bold text-[#0d2c63] border-4 border-white">
          <%= @customer.display_name.first.upcase %>
        </div>
      </div>
    </div>

    <div class="pt-14 px-6 pb-6">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <p class="font-bold text-lg text-gray-800"><%= @customer.display_name %></p>
          <p class="text-sm text-gray-400">Customer since <%= @customer.created_at.strftime("%B %Y") %></p>
        </div>
        <div class="flex gap-2">
          <%= link_to edit_admin_customer_path(@customer),
            class: "inline-flex items-center gap-1.5 text-sm font-medium text-[#0d2c63] bg-blue-50 hover:bg-blue-100 px-3 py-2 rounded-lg transition" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
            </svg>
            Edit
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600 text-xl">📦</div>
      <div>
        <p class="text-sm text-gray-400 font-medium">Total Orders</p>
        <p class="text-2xl font-bold text-[#0d2c63]"><%= @customer.orders.count %></p>
      </div>
    </div>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 text-xl">💰</div>
      <div>
        <p class="text-sm text-gray-400 font-medium">Total Spent</p>
        <p class="text-2xl font-bold text-emerald-600">₹<%= number_with_precision(@customer.orders.sum(:total_amount), precision: 2) %></p>
      </div>
    </div>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center text-amber-600 text-xl">⏳</div>
      <div>
        <p class="text-sm text-gray-400 font-medium">Pending Orders</p>
        <p class="text-2xl font-bold text-amber-500"><%= @customer.orders.where(status: 'pending').count %></p>
      </div>
    </div>
  </div>

  <!-- Contact Info -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-6">
    <div class="px-6 py-4 border-b border-gray-100">
      <h2 class="font-semibold text-gray-800 flex items-center gap-2">
        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        Contact Information
      </h2>
    </div>
    <div class="divide-y divide-gray-100">
      <div class="px-6 py-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-purple-50 flex items-center justify-center text-purple-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <div>
          <p class="text-xs text-gray-400 font-medium uppercase">Email</p>
          <p class="font-medium text-gray-800"><%= @customer.email %></p>
        </div>
      </div>
      <div class="px-6 py-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-teal-50 flex items-center justify-center text-teal-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
        </div>
        <div>
          <p class="text-xs text-gray-400 font-medium uppercase">Phone</p>
          <p class="font-medium text-gray-800"><%= @customer.contact.presence || "Not added" %></p>
        </div>
      </div>
      <div class="px-6 py-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center text-amber-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
        <div>
          <p class="text-xs text-gray-400 font-medium uppercase">Member Since</p>
          <p class="font-medium text-gray-800"><%= @customer.created_at.strftime("%d %b %Y") %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Orders List -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
      <h2 class="font-semibold text-gray-800 flex items-center gap-2">
        <span class="text-lg">📦</span>
        Recent Orders
      </h2>
      <span class="text-sm text-gray-400"><%= @orders.count %> shown</span>
    </div>

    <% if @orders.any? %>
      <!-- Desktop Table -->
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left">
          <thead class="bg-gray-50/60">
            <tr>
              <th class="py-3 px-5 text-xs font-semibold text-gray-400 uppercase tracking-wider">Order #</th>
              <th class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Date</th>
              <th class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Amount</th>
              <th class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Status</th>
              <th class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Payment</th>
              <th class="text-right text-xs font-semibold text-gray-400 uppercase tracking-wider px-5">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @orders.each do |order| %>
              <tr class="hover:bg-gray-50/50 transition">
                <td class="py-3.5 px-5 font-bold text-[#0d2c63]">#<%= order.id %></td>
                <td class="text-sm text-gray-500 whitespace-nowrap"><%= order.created_at.strftime("%d %b %Y, %I:%M %p") %></td>
                <td class="text-sm font-semibold text-gray-800">₹<%= order.total_amount %></td>
                <td>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold <%= order.status_badge_class %>">
                    <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                    <%= order.status.titleize %>
                  </span>
                </td>
                <td>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold <%= order.payment_badge_class %>">
                    <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                    <%= order.payment_status.titleize %>
                  </span>
                </td>
                <td class="text-right px-5">
                  <%= link_to "View", admin_order_path(order),
                    class: "text-xs font-medium text-[#0d2c63] bg-blue-50 hover:bg-blue-100 px-3 py-1.5 rounded-lg transition" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Mobile Cards -->
      <div class="md:hidden space-y-3 p-4">
        <% @orders.each do |order| %>
          <div class="border border-gray-100 rounded-xl p-4 bg-gray-50">
            <div class="flex justify-between items-center mb-2">
              <span class="font-bold text-sm text-[#0d2c63]">#<%= order.id %></span>
              <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-full text-xs font-semibold <%= order.status_badge_class %>">
                <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                <%= order.status.titleize %>
              </span>
            </div>
            <div class="flex justify-between text-sm mb-1">
              <span class="text-gray-500">₹<%= order.total_amount %></span>
              <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-full text-xs font-semibold <%= order.payment_badge_class %>">
                <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                <%= order.payment_status.titleize %>
              </span>
            </div>
            <p class="text-xs text-gray-400 mb-3"><%= order.created_at.strftime("%d %b %Y, %I:%M %p") %></p>
            <%= link_to "View", admin_order_path(order),
              class: "block text-center text-xs font-medium text-[#0d2c63] bg-blue-50 hover:bg-blue-100 px-3 py-2 rounded-lg transition" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-10">
        <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">📦</div>
        <p class="text-gray-500">No orders placed yet.</p>
      </div>
    <% end %>
  </div>
</div>
