<% content_for :title, "Edit Profile" %>

<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold mb-6">Edit Profile ✏️</h1>

  <%= form_with model: @vendor, url: vendor_profile_path, method: :patch, class: "bg-white rounded-xl shadow p-6 space-y-4" do |f| %>
    <div>
      <%= f.label :shop_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :shop_name, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div>
      <%= f.label :contact_number, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :contact_number, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div>
      <%= f.label :address, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :address, rows: 3, class: "w-full border rounded-lg px-3 py-2" %>
    </div>

    <div class="flex gap-3 pt-2">
      <%= f.submit "Save Changes",
        class: "bg-[#0d2c63] text-white px-4 py-2 rounded hover:scale-105 transition cursor-pointer" %>
      <%= link_to "Cancel", vendor_profile_path,
        class: "px-4 py-2 border rounded hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
