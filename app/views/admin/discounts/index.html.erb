<% content_for :page_title, "Discounts" %>

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-3">
  <h1 class="text-xl md:text-2xl font-bold text-gray-800">Discounts 🏷️</h1>
  <%= link_to "+ Add Discount", new_admin_discount_path,
    class: "bg-[#0d2c63] text-white px-4 py-2 rounded-lg hover:shadow-lg hover:-translate-y-0.5 transition text-sm font-medium shrink-0" %>
</div>

<% if @discounts.any? %>
  <!-- Desktop Table -->
  <div class="hidden md:block bg-white rounded-xl shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead class="bg-gray-50">
          <tr>
            <th class="py-3 px-4">Code</th>
            <th>Type</th>
            <th>Value</th>
            <th>Min Order</th>
            <th>Expiry</th>
            <th>Used</th>
            <th>Status</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @discounts.each do |discount| %>
            <tr class="border-t hover:bg-gray-50">
              <td class="py-3 px-4 font-medium"><%= discount.code %></td>
              <td class="text-sm text-gray-600"><%= discount.discount_type.titleize %></td>
              <td class="font-medium"><%= discount.display_value %></td>
              <td><%= discount.min_order_amount.present? ? "₹#{discount.min_order_amount}" : "—" %></td>
              <td class="text-sm text-gray-500"><%= discount.expiry_date&.strftime("%d %b %Y") || "Never" %></td>
              <td><%= discount.usage_count %> / <%= discount.usage_limit || "∞" %></td>
              <td>
                <% if discount.active? && (discount.expiry_date.nil? || discount.expiry_date >= Date.current) %>
                  <span class="px-2 py-1 bg-green-100 text-green-800 rounded-full text-xs font-medium">Active</span>
                <% else %>
                  <span class="px-2 py-1 bg-gray-100 text-gray-800 rounded-full text-xs font-medium">Inactive</span>
                <% end %>
              </td>
              <td class="text-right px-4">
                <div class="flex gap-2 justify-end">
                  <%= link_to "Edit", edit_admin_discount_path(discount),
                    class: "text-xs bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700" %>
                  <%= button_to "Delete", admin_discount_path(discount),
                    method: :delete,
                    data: { turbo_confirm: "Are you sure?" },
                    class: "text-xs bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mobile Cards -->
  <div class="md:hidden space-y-3">
    <% @discounts.each do |discount| %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
        <div class="flex justify-between items-start mb-2">
          <div>
            <p class="font-bold text-gray-800"><%= discount.code %></p>
            <p class="text-xs text-gray-500 mt-0.5"><%= discount.discount_type.titleize %> · <%= discount.display_value %></p>
          </div>
          <% if discount.active? && (discount.expiry_date.nil? || discount.expiry_date >= Date.current) %>
            <span class="px-2 py-1 bg-green-100 text-green-800 rounded-full text-xs font-medium">Active</span>
          <% else %>
            <span class="px-2 py-1 bg-gray-100 text-gray-800 rounded-full text-xs font-medium">Inactive</span>
          <% end %>
        </div>
        <div class="grid grid-cols-2 gap-2 text-sm mb-3">
          <div>
            <p class="text-xs text-gray-400">Min Order</p>
            <p class="font-medium"><%= discount.min_order_amount.present? ? "₹#{discount.min_order_amount}" : "—" %></p>
          </div>
          <div>
            <p class="text-xs text-gray-400">Expiry</p>
            <p class="font-medium"><%= discount.expiry_date&.strftime("%d %b %Y") || "Never" %></p>
          </div>
          <div>
            <p class="text-xs text-gray-400">Used</p>
            <p class="font-medium"><%= discount.usage_count %> / <%= discount.usage_limit || "∞" %></p>
          </div>
        </div>
        <div class="flex gap-2 pt-3 border-t border-gray-100">
          <%= link_to "Edit", edit_admin_discount_path(discount),
            class: "flex-1 text-center text-xs bg-blue-600 text-white px-3 py-2 rounded-lg hover:bg-blue-700" %>
          <%= button_to "Delete", admin_discount_path(discount),
            method: :delete,
            data: { turbo_confirm: "Are you sure?" },
            class: "flex-1 text-xs bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-700 bg-transparent border-0 cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl shadow p-10 md:p-16 text-center">
    <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl">🏷️</div>
    <p class="text-gray-500 text-lg mb-4">No discounts created yet.</p>
    <%= link_to "Add Discount", new_admin_discount_path,
      class: "bg-[#0d2c63] text-white px-6 py-2 rounded-lg hover:shadow-lg hover:-translate-y-0.5 transition inline-block font-medium" %>
  </div>
<% end %>
