<% content_for :page_title, "Edit Raw Material" %>

<div class="max-w-xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">Edit Raw Material ✏️</h1>

  <%= form_with model: [:admin, @raw_material], class: "bg-white rounded-xl shadow p-6 space-y-4" do |f| %>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full border rounded-lg px-3 py-2" %>
      </div>
      <div>
        <%= f.label :category, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :category, RawMaterial::CATEGORIES, {}, class: "w-full border rounded-lg px-3 py-2" %>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-4">
      <div>
        <%= f.label :quantity, "Stock Qty", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :quantity, class: "w-full border rounded-lg px-3 py-2" %>
      </div>
      <div>
        <%= f.label :unit, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :unit, class: "w-full border rounded-lg px-3 py-2" %>
      </div>
      <div>
        <%= f.label :min_stock_level, "Min Level", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :min_stock_level, class: "w-full border rounded-lg px-3 py-2" %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :cost_per_unit, "Cost per Unit (₹)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :cost_per_unit, step: 0.01, class: "w-full border rounded-lg px-3 py-2" %>
      </div>
      <div>
        <%= f.label :supplier_name, "Supplier", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :supplier_name, class: "w-full border rounded-lg px-3 py-2" %>
      </div>
    </div>

    <div class="flex gap-3 pt-2">
      <%= f.submit "Update Material",
        class: "bg-[#0d2c63] text-white px-4 py-2 rounded hover:scale-105 transition cursor-pointer" %>
      <%= link_to "Cancel", admin_raw_materials_path,
        class: "px-4 py-2 border rounded hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
