        </div>
      </div>

      <!-- Right: Static Bottle Image -->
      <div class="order-1 lg:order-2 flex justify-center reveal reveal-right">
        <div class="relative">
          <!-- Soft glow behind bottle -->
          <div class="absolute inset-0 bg-gradient-to-br from-cyan-300/20 via-blue-400/15 to-teal-300/20 rounded-full blur-[80px] scale-125"></div>
          <!-- No decorative rings -->
          <!-- Static bottle -->
          <img src="/images/bottlepng.png" alt="Puroxa Water Bottle"
            class="relative z-10 h-72 md:h-96 lg:h-[28rem] object-contain drop-shadow-2xl"
            onerror="this.style.display='none'">
          <!-- Floating label -->
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ==================== WHY CHOOSE ==================== -->
