<% content_for :title, "Add Address" %>

<div class="max-w-2xl mx-auto">
  <!-- Header -->
  <div class="mb-6 md:mb-8">
    <h1 class="text-xl md:text-2xl font-bold text-gray-800 flex items-center gap-2">
      <span class="w-1 h-6 bg-[#0d2c63] rounded-full"></span>
      Add New Address 📍
    </h1>
  </div>

  <%= form_with model: @address, url: customer_addresses_path, class: "bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden" do |f| %>
    <div class="p-5 md:p-8 space-y-5">
      <div>
        <%= f.label :label, "Label (e.g. Home, Office)", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.text_field :label,
          class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#0d2c63]/20 focus:border-[#0d2c63] outline-none transition" %>
      </div>

      <div>
        <%= f.label :address_line, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.text_area :address_line, rows: 2,
          class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#0d2c63]/20 focus:border-[#0d2c63] outline-none transition" %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :city, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.text_field :city,
            class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#0d2c63]/20 focus:border-[#0d2c63] outline-none transition" %>
        </div>
        <div>
          <%= f.label :state, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.text_field :state,
            class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#0d2c63]/20 focus:border-[#0d2c63] outline-none transition" %>
        </div>
      </div>

      <div>
        <%= f.label :pincode, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= f.text_field :pincode,
          class: "w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#0d2c63]/20 focus:border-[#0d2c63] outline-none transition" %>
      </div>

      <label class="flex items-center gap-3 p-3 rounded-xl border border-gray-200 hover:bg-gray-50 cursor-pointer transition">
        <%= f.check_box :is_default, class: "accent-[#0d2c63] w-4 h-4" %>
        <%= f.label :is_default, "Set as default address", class: "text-sm font-medium text-gray-700 cursor-pointer" %>
      </label>
    </div>

    <div class="px-5 md:px-8 py-5 border-t border-gray-100 bg-gray-50/50 flex flex-col sm:flex-row gap-3">
      <%= f.submit "Save Address",
        class: "bg-[#0d2c63] text-white px-6 py-2.5 rounded-xl hover:shadow-lg hover:-translate-y-0.5 transition cursor-pointer text-sm font-semibold" %>
      <%= link_to "Cancel", customer_addresses_path,
        class: "px-6 py-2.5 border border-gray-300 rounded-xl hover:bg-gray-100 text-center text-sm font-medium text-gray-700 transition" %>
    </div>
  <% end %>
</div>
