<% content_for(:title) { "Vendor login — Puroxa Water" } %>

<div class="min-h-screen flex flex-col md:flex-row">
  <%# Left: Branding panel (cyan accent for vendor side) %>
  <%= render "shared/auth_branding", accent: "cyan", variant: :login %>

  <%# Right: Form panel %>
  <div class="flex-1 flex items-center justify-center px-5 py-10 md:py-12 bg-gradient-to-br from-cyan-50/40 via-white to-sky-50">
    <div class="w-full max-w-md">

      <!-- Mobile-only inline brand (hidden on md+) -->
      <div class="md:hidden text-center mb-6">
        <div class="inline-flex w-12 h-12 rounded-xl bg-gradient-to-br from-cyan-500 to-sky-500 items-center justify-center shadow-lg">
          <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.69l5.66 5.66a8 8 0 11-11.32 0L12 2.69z"/>
          </svg>
        </div>
        <h2 class="text-xl font-extrabold text-[#0d2c63] mt-3">Puroxa Vendor</h2>
      </div>

      <div class="text-center md:text-left mb-7">
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight">Vendor sign in</h2>
        <p class="text-sm text-gray-500 mt-1.5">Manage orders, deliveries &amp; collections</p>
      </div>

      <%= form_with url: vendor_login_path, method: :post, local: true, html: { class: "space-y-4" } do |f| %>
        <%= render "shared/auth_field",
              form: f,
              name: :login,
              type: :text,
              label: "Email or Mobile",
              placeholder: "you@vendor.com or 9876543210",
              autocomplete: "username",
              required: true,
              icon: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" %>

        <%= render "shared/auth_field",
              form: f,
              name: :password,
              type: :password,
              label: "Password",
              placeholder: "••••••••",
              autocomplete: "current-password",
              required: true,
              icon: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" %>

        <div class="flex items-center justify-between text-sm">
          <span class="text-gray-500 text-xs">
            <svg class="inline w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Approved vendors only
          </span>
          <%= link_to "Forgot password?", root_path, class: "text-cyan-700 hover:text-cyan-800 font-medium" %>
        </div>

        <%= f.submit "Sign in",
              class: "w-full mt-2 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-sky-500 text-white font-semibold shadow-lg shadow-cyan-200 hover:shadow-xl hover:from-cyan-600 hover:to-sky-600 hover:-translate-y-0.5 transition cursor-pointer" %>
      <% end %>

      <div class="my-6 flex items-center gap-3 text-xs text-gray-400">
        <div class="flex-1 h-px bg-gray-200"></div>
        <span>OR</span>
        <div class="flex-1 h-px bg-gray-200"></div>
      </div>

      <div class="text-center text-sm text-gray-600">
        New vendor?
        <%= link_to "Apply for an account", vendor_signup_path,
              class: "text-cyan-700 hover:text-cyan-800 font-semibold ml-1" %>
      </div>

      <p class="text-center text-xs text-gray-500 mt-8">
        Not a vendor?
        <%= link_to "Customer login →", new_user_session_path, class: "text-sky-700 hover:underline font-medium" %>
      </p>
    </div>
  </div>
</div>
